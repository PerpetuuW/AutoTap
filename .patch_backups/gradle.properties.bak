# AutoTap Greenfield Architecture — Gradle Properties (v34.0)

# Обязательная активация AndroidX для современных зависимостей
android.useAndroidX=true

# Оптимизация памяти демона сборщика
org.gradle.jvmargs=-Xmx2048m -Dfile.encoding=UTF-8

# Отключение нестабильного configuration-cache для совместимости с AGP 8.5 и Kotlin 1.9
org.gradle.configuration-cache=false

# Подавление предупреждений SDK в случае внешних сборок
android.suppressUnsupportedCompileSdk=34,35

# Стандартный стиль оформления кода
kotlin.code.style=official

# Параллельная сборка независимых модулей
org.gradle.parallel=true

# Enabled parallel sync for Gradle 9.4+
org.gradle.tooling.parallel=true
android.uniquePackageNames=false
android.dependency.useConstraints=true
android.r8.strictFullModeForKeepRules=false



# --- AGP 9.0+ / KGP Compatibility & Warning Suppression ---


# --- AGP 9.0+ / KGP Compatibility & Warning Suppression ---
android.builtInKotlin=false
android.newDsl=false
android.sync.suppressAgpWarnings=UNSUPPORTED_PROJECT_OPTION_USE,DEPRECATED_DSL,LIBRARY_CONSTRAINTS_SHOULD_BE_DISABLED
android.generateSyncIssueWhenLibraryConstraintsAreEnabled=false
