package com.example.autotap.presentation.main

import android.annotation.SuppressLint
import android.content.Context
import android.content.Intent
import android.content.res.ColorStateList
import android.media.projection.MediaProjectionManager
import android.net.Uri
import android.os.Build
import android.os.Bundle
import android.provider.Settings
import android.widget.Button
import android.widget.TextView
import android.widget.Toast
import androidx.activity.result.contract.ActivityResultContracts
import androidx.appcompat.app.AlertDialog
import androidx.appcompat.app.AppCompatActivity
import androidx.core.graphics.toColorInt
import androidx.core.view.WindowCompat
import com.example.autotap.R
import com.example.autotap.core.accessibility.AccessibilityUtils
import com.example.autotap.core.inspection.ProjectIntegrityInspector
import com.example.autotap.core.logger.AppLogger
import com.example.autotap.infrastructure.accessibility.AutoTapAccessibilityService
import com.example.autotap.infrastructure.orchestrator.AutoTapOrchestrator
import com.example.autotap.infrastructure.overlay.dialog.LogViewerDialog
import com.example.autotap.infrastructure.projection.MediaProjectionService
import java.io.BufferedInputStream
import java.io.File
import java.io.FileInputStream
import java.io.FileOutputStream
import java.util.zip.ZipInputStream

@SuppressLint("SetTextI18n")
class MainActivity : AppCompatActivity() {

    private val orchestrator by lazy { AutoTapOrchestrator.getInstance(this) }

    private val importZipLauncher = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
        if (result.resultCode == RESULT_OK && result.data != null) {
            val uri = result.data?.data ?: return@registerForActivityResult
            val tempZip = File(cacheDir, "temp_import.zip")
            try {
                contentResolver.openInputStream(uri)?.use { input ->
                    FileOutputStream(tempZip).use { out -> input.copyTo(out) }
                }
                val success = ZipInputStream(BufferedInputStream(FileInputStream(tempZip))).use { zis ->
                    orchestrator.backupManager.importPackageZip(zis)
                }
                Toast.makeText(this, if (success) "Сценарии и маски успешно импортированы" else "Ошибка распаковки", Toast.LENGTH_SHORT).show()
            } catch (_: Exception) {
                Toast.makeText(this, "Ошибка импорта ZIP", Toast.LENGTH_SHORT).show()
            } finally {
                if (tempZip.exists()) {
                    tempZip.delete()
                }
            }
        }
    }

    private val mediaProjectionLauncher = registerForActivityResult(ActivityResultContracts.StartActivityForResult()) { result ->
        if (result.resultCode == RESULT_OK && result.data != null) {
            val serviceIntent = Intent(this, MediaProjectionService::class.java).apply {
                action = MediaProjectionService.ACTION_START
                putExtra(MediaProjectionService.EXTRA_RESULT_CODE, result.resultCode)
                putExtra(MediaProjectionService.EXTRA_RESULT_DATA, result.data)
            }
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
                startForegroundService(serviceIntent)
            } else {
                startService(serviceIntent)
            }
            Toast.makeText(this, "Режим 60 FPS (MediaProjection) активирован", Toast.LENGTH_SHORT).show()
            updatePermissionButtons()
        }
    }

    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        WindowCompat.setDecorFitsSystemWindows(window, true)
        setContentView(R.layout.activity_main)

        AppLogger.init(applicationContext)
        findViewById<TextView>(R.id.tvVersion)?.text = "v34.9 Greenfield Precision Core"

        ProjectIntegrityInspector.inspectProjectStorage(this)

        findViewById<Button>(R.id.btnSecurityInfo)?.setOnClickListener {
            showSecurityDetailsDialog()
        }

        findViewById<Button>(R.id.btnAppDetails)?.setOnClickListener {
            showRestrictedSettingsDialog()
        }

        findViewById<Button>(R.id.btnAccessibility)?.setOnClickListener {
            startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
        }

        findViewById<Button>(R.id.btnOverlay)?.setOnClickListener {
            startActivity(Intent(Settings.ACTION_MANAGE_OVERLAY_PERMISSION, Uri.parse("package:$packageName")))
        }

        findViewById<Button>(R.id.btnMediaProjection)?.setOnClickListener {
            if (MediaProjectionService.isStreaming) {
                val stopIntent = Intent(this, MediaProjectionService::class.java).apply {
                    action = MediaProjectionService.ACTION_STOP
                }
                startService(stopIntent)
                Toast.makeText(this, "60 FPS захват остановлен", Toast.LENGTH_SHORT).show()
                updatePermissionButtons()
            } else {
                val mpManager = getSystemService(Context.MEDIA_PROJECTION_SERVICE) as MediaProjectionManager
                mediaProjectionLauncher.launch(mpManager.createScreenCaptureIntent())
            }
        }

        findViewById<Button>(R.id.btnStartPanel)?.setOnClickListener {
            val isAccessibilityActive = AutoTapAccessibilityService.instance != null ||
                    AccessibilityUtils.isServiceEnabled(this, AutoTapAccessibilityService::class.java)
            val hasOverlayPermission = Settings.canDrawOverlays(this)

            if (!isAccessibilityActive && !hasOverlayPermission) {
                Toast.makeText(this, "Включите службу кликера или разрешите показ поверх окон", Toast.LENGTH_LONG).show()
                startActivity(Intent(Settings.ACTION_ACCESSIBILITY_SETTINGS))
                return@setOnClickListener
            }

            if (!isAccessibilityActive) {
                Toast.makeText(this, "Внимание: служба кликера не включена — жесты не смогут выполняться", Toast.LENGTH_SHORT).show()
            }

            orchestrator.showOverlays()
            moveTaskToBack(true)
        }

        findViewById<Button>(R.id.btnViewLogs)?.setOnClickListener {
            LogViewerDialog(this, orchestrator.overlayWindowManager).show()
        }

        findViewById<Button>(R.id.btnExport)?.setOnClickListener {
            val fullZip = orchestrator.backupManager.exportFullBackupZip()
            if (fullZip != null) {
                orchestrator.backupManager.shareZipFile(fullZip, "Полный бэкап AutoTap PRO")
            }
        }

        findViewById<Button>(R.id.btnImport)?.setOnClickListener {
            val intent = Intent(Intent.ACTION_OPEN_DOCUMENT).apply {
                type = "application/zip"
                addCategory(Intent.CATEGORY_OPENABLE)
            }
            importZipLauncher.launch(intent)
        }
    }

    override fun onResume() {
        super.onResume()
        updatePermissionButtons()
    }

    private fun showRestrictedSettingsDialog() {
        AlertDialog.Builder(this)
            .setTitle("Разрешить ограниченные настройки (Android 13+)")
            .setMessage("Если в меню Спец. возможностей служба кликера недоступна:\n\n" +
                    "1. Нажмите «Перейти в настройки» ниже.\n" +
                    "2. Нажмите на три точки (⋮) в правом верхнем углу экрана.\n" +
                    "3. Выберите «Разрешить ограниченные настройки» и подтвердите разблокировку (PIN/отпечаток).\n\n" +
                    "После этого вернитесь в AutoTap и включите службу кликера в шаге 2.")
            .setPositiveButton("Перейти в настройки") { _, _ ->
                val intent = Intent(Settings.ACTION_APPLICATION_DETAILS_SETTINGS).apply {
                    data = Uri.fromParts("package", packageName, null)
                }
                startActivity(intent)
            }
            .setNegativeButton("Понятно", null)
            .show()
    }

    private fun showSecurityDetailsDialog() {
        AlertDialog.Builder(this)
            .setTitle("Безопасность и офлайн-приватность")
            .setMessage("• ПОЛНАЯ ИЗОЛЯЦИЯ ОТ СЕТИ:\n" +
                    "Приложение не содержит доступа в Интернет. Никакие изображения экрана не передаются наружу.\n\n" +
                    "• ОВЕРЛЕИ И КЛАВИАТУРА:\n" +
                    "Для ввода текста и работы клавиатуры в плавающих окнах обязательно включите разрешение «Поверх других приложений» в шаге 3.")
            .setPositiveButton("Понятно", null)
            .show()
    }

    private fun updatePermissionButtons() {
        val btnAccess = findViewById<Button>(R.id.btnAccessibility)
        val btnOverlay = findViewById<Button>(R.id.btnOverlay)
        val btnProjection = findViewById<Button>(R.id.btnMediaProjection)

        val isServiceRunning = AutoTapAccessibilityService.instance != null ||
                AccessibilityUtils.isServiceEnabled(this, AutoTapAccessibilityService::class.java)
        val isOverlayOk = Settings.canDrawOverlays(this)
        val isStreamRunning = MediaProjectionService.isStreaming

        btnAccess?.apply {
            text = if (isServiceRunning) "2. Служба кликера: ВКЛЮЧЕНА" else "2. Разрешить работу службы кликера"
            backgroundTintList = ColorStateList.valueOf(if (isServiceRunning) "#1E3A2B".toColorInt() else "#21262D".toColorInt())
        }

        btnOverlay?.apply {
            if (isOverlayOk) {
                text = "3. Поверх других приложений: РАЗРЕШЕНО (Клавиатура активна)"
                backgroundTintList = ColorStateList.valueOf("#1E3A2B".toColorInt())
            } else {
                text = "3. Поверх других приложений: НАЖМИТЕ ДЛЯ ВКЛЮЧЕНИЯ КЛАВИАТУРЫ"
                backgroundTintList = ColorStateList.valueOf("#B42318".toColorInt())
            }
        }

        btnProjection?.apply {
            text = if (isStreamRunning) "4. Режим 60 FPS: АКТИВЕН" else "4. Включить 60 FPS Захват (Direct Stream)"
            backgroundTintList = ColorStateList.valueOf(if (isStreamRunning) "#0E4429".toColorInt() else "#1F6FEB".toColorInt())
        }
    }
}
