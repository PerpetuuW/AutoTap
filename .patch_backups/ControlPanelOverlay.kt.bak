package com.example.autotap.infrastructure.overlay.panel

import android.annotation.SuppressLint
import android.content.Context
import android.graphics.Canvas
import android.graphics.Color
import android.graphics.Paint
import android.graphics.RectF
import android.graphics.drawable.GradientDrawable
import android.view.Gravity
import android.view.MotionEvent
import android.view.View
import android.view.ViewOutlineProvider
import android.widget.FrameLayout
import android.widget.LinearLayout
import com.example.autotap.core.logger.AppLogger
import com.example.autotap.infrastructure.overlay.OverlayWindowManager
import com.example.autotap.infrastructure.overlay.model.PanelDisplayMode
import com.example.autotap.infrastructure.overlay.tutorial.InteractiveTutorialOverlay
import com.example.autotap.infrastructure.overlay.ui.VectorIconDrawer
import kotlin.math.abs

@SuppressLint("ClickableViewAccessibility", "SetTextI18n")
class ControlPanelOverlay(
    private val context: Context,
    private val overlayWindowManager: OverlayWindowManager,
    private val listener: ControlPanelListener
) {

    private var rootView: View? = null
    private var rootLinearView: LinearLayout? = null
    private var currentMode: PanelDisplayMode = PanelDisplayMode.EXPANDED
    private var isPlayingState: Boolean = false
    private var isNumbersHiddenState: Boolean = false
    private var btnHideRef: View? = null

    private val dm = context.resources.displayMetrics
    private fun dp(value: Int): Int = (value * dm.density).toInt()
    private fun dpF(value: Float): Float = value * dm.density

    private var posX = dp(20)
    private var posY = dp(140)

    fun updateNumbersHiddenState(isHidden: Boolean) {
        isNumbersHiddenState = isHidden
        btnHideRef?.invalidate()
    }

    fun show() {
        if (rootView != null && rootView?.parent != null) {
            rootView?.visibility = View.VISIBLE
            return
        }

        if (rootView != null && rootView?.parent == null) {
            rootView = null
        }

        val container = FrameLayout(context)
        rootView = container

        buildViewHierarchy(container)

        val layoutParams = overlayWindowManager.createLayoutParams().apply {
            this.x = posX
            this.y = posY
        }

        overlayWindowManager.addViewSafe(container, layoutParams)
        applyDisplayMode(currentMode)
        AppLogger.log(context, "PANEL", "Плавающая панель управления открыта")
    }

    fun hide() {
        rootView?.let {
            overlayWindowManager.removeViewSafe(it)
            rootView = null
            rootLinearView = null
            btnHideRef = null
        }
    }

    fun setPlayState(isPlaying: Boolean) {
        isPlayingState = isPlaying
        rootView?.findViewWithTag<View>("BTN_PLAY_VIEW")?.let { v ->
            v.background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor(if (isPlaying) "#F04438" else "#10B981"), Color.parseColor("#161B22"))
            ).apply {
                cornerRadius = dpF(10f)
                setStroke(dp(1), Color.parseColor(if (isPlaying) "#F04438" else "#00F5D4"))
            }
            v.invalidate()
        }
    }

    fun applyDisplayMode(mode: PanelDisplayMode) {
        currentMode = mode
        val mainRow = rootView?.findViewWithTag<LinearLayout>("MAIN_ROW")
        val subRow = rootView?.findViewWithTag<LinearLayout>("SUB_ROW")
        val bubble = rootView?.findViewWithTag<View>("MINI_BUBBLE")
        val toggleBtn = rootView?.findViewWithTag<View>("BTN_TOGGLE_VIEW")

        when (mode) {
            PanelDisplayMode.EXPANDED -> {
                rootLinearView?.visibility = View.VISIBLE
                mainRow?.visibility = View.VISIBLE
                subRow?.visibility = View.VISIBLE
                bubble?.visibility = View.GONE
            }
            PanelDisplayMode.COMPACT_SINGLE_ROW -> {
                rootLinearView?.visibility = View.VISIBLE
                mainRow?.visibility = View.VISIBLE
                subRow?.visibility = View.GONE
                bubble?.visibility = View.GONE
            }
            PanelDisplayMode.MINI_BUBBLE -> {
                rootLinearView?.visibility = View.GONE
                mainRow?.visibility = View.GONE
                subRow?.visibility = View.GONE
                bubble?.visibility = View.VISIBLE
            }
        }
        toggleBtn?.invalidate()

        rootView?.let { v ->
            val lp = overlayWindowManager.createLayoutParams().apply {
                this.x = posX
                this.y = posY
            }
            overlayWindowManager.updateViewSafe(v, lp)
        }
    }

    private fun buildViewHierarchy(container: FrameLayout) {
        val rootLinear = LinearLayout(context).apply {
            orientation = LinearLayout.VERTICAL
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor("#F8161B22"), Color.parseColor("#F80D1117"))
            ).apply {
                cornerRadius = dpF(18f)
                setStroke(dp(1), Color.parseColor("#00F5D4"))
            }
            val p = dp(5)
            setPadding(p, p, p, p)
            elevation = dpF(18f)
        }
        rootLinearView = rootLinear

        val miniBubble = object : View(context) {
            private val bounds = RectF()
            override fun onDraw(canvas: Canvas) {
                super.onDraw(canvas)
                bounds.set(dpF(8f), dpF(8f), width - dpF(8f), height - dpF(8f))
                VectorIconDrawer.drawIcon(canvas, VectorIconDrawer.IconType.DRAG_HANDLE, bounds, Color.parseColor("#00F5D4"), dpF(2.5f))
            }
        }.apply {
            tag = "MINI_BUBBLE"
            outlineProvider = ViewOutlineProvider.BACKGROUND
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor("#1F6FEB"), Color.parseColor("#161B22"))
            ).apply {
                shape = GradientDrawable.OVAL
                setStroke(dp(1), Color.parseColor("#58A6FF"))
            }
            layoutParams = FrameLayout.LayoutParams(dp(44), dp(44))
            elevation = dpF(8f)
            visibility = View.GONE
            setOnClickListener {
                applyDisplayMode(PanelDisplayMode.EXPANDED)
            }
        }
        attachDragListener(miniBubble)
        container.addView(miniBubble)

        val mainRow = LinearLayout(context).apply {
            tag = "MAIN_ROW"
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
        }

        val dragHandle = createIconButton(VectorIconDrawer.IconType.DRAG_HANDLE, "#21262D", "#58A6FF", dp(42), "BTN_DRAG") {}
        attachDragListener(dragHandle)
        mainRow.addView(dragHandle)

        val playIconView = object : View(context) {
            private val bounds = RectF()
            override fun onDraw(canvas: Canvas) {
                super.onDraw(canvas)
                bounds.set(dpF(10f), dpF(10f), width - dpF(10f), height - dpF(10f))
                val icon = if (isPlayingState) VectorIconDrawer.IconType.PAUSE else VectorIconDrawer.IconType.PLAY
                VectorIconDrawer.drawIcon(canvas, icon, bounds, Color.WHITE, dpF(2.5f))
            }
        }.apply {
            tag = "BTN_PLAY_VIEW"
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor(if (isPlayingState) "#F04438" else "#10B981"), Color.parseColor("#161B22"))
            ).apply {
                cornerRadius = dpF(10f)
                setStroke(dp(1), Color.parseColor(if (isPlayingState) "#F04438" else "#00F5D4"))
            }
            elevation = dpF(4f)
            val size = dp(42)
            layoutParams = LinearLayout.LayoutParams(size, size).apply {
                val m = dp(2)
                setMargins(m, m, m, m)
            }
            setOnClickListener { listener.onPlayClicked() }
            setOnLongClickListener {
                listener.onPlayLongClicked()
                true
            }
        }
        mainRow.addView(playIconView)

        val btnAdd = createIconButton(VectorIconDrawer.IconType.PLUS, "#21262D", "#00F5D4", dp(42), "BTN_ADD") { listener.onAddClicked() }
        mainRow.addView(btnAdd)

        val btnRecord = createIconButton(VectorIconDrawer.IconType.RECORD, "#21262D", "#F04438", dp(42), "BTN_RECORD") { listener.onRecordClicked() }
        mainRow.addView(btnRecord)

        val btnCapture = createIconButton(VectorIconDrawer.IconType.CAPTURE, "#21262D", "#38BDF8", dp(42), "BTN_CAPTURE") { listener.onCaptureClicked() }
        mainRow.addView(btnCapture)

        val btnToggle = object : View(context) {
            private val bounds = RectF()
            override fun onDraw(canvas: Canvas) {
                super.onDraw(canvas)
                bounds.set(dpF(10f), dpF(10f), width - dpF(10f), height - dpF(10f))
                val icon = if (currentMode == PanelDisplayMode.EXPANDED) VectorIconDrawer.IconType.PANEL_COLLAPSE else VectorIconDrawer.IconType.PANEL_EXPAND
                VectorIconDrawer.drawIcon(canvas, icon, bounds, Color.parseColor("#FFB703"), dpF(2.2f))
            }
        }.apply {
            tag = "BTN_TOGGLE_VIEW"
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor("#21262D"), Color.parseColor("#161B22"))
            ).apply {
                cornerRadius = dpF(10f)
                setStroke(dp(1), Color.parseColor("#FFB703"))
            }
            elevation = dpF(4f)
            val size = dp(42)
            layoutParams = LinearLayout.LayoutParams(size, size).apply {
                val m = dp(2)
                setMargins(m, m, m, m)
            }
            setOnClickListener {
                val next = when (currentMode) {
                    PanelDisplayMode.EXPANDED -> PanelDisplayMode.COMPACT_SINGLE_ROW
                    PanelDisplayMode.COMPACT_SINGLE_ROW -> PanelDisplayMode.MINI_BUBBLE
                    PanelDisplayMode.MINI_BUBBLE -> PanelDisplayMode.EXPANDED
                }
                applyDisplayMode(next)
            }
        }
        mainRow.addView(btnToggle)

        val btnClose = createIconButton(VectorIconDrawer.IconType.CLOSE, "#21262D", "#F04438", dp(42), "BTN_CLOSE") { listener.onCloseClicked() }
        mainRow.addView(btnClose)

        rootLinear.addView(mainRow)

        val subRow = LinearLayout(context).apply {
            tag = "SUB_ROW"
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setPadding(0, dp(3), 0, 0)
        }

        val btnGraph = createIconButton(VectorIconDrawer.IconType.GRAPH_TREE, "#1F6FEB", "#00F5D4", dp(36), "BTN_GRAPH") {
            listener.onGraphClicked()
        }
        subRow.addView(btnGraph)

        val btnScripts = createIconButton(VectorIconDrawer.IconType.SCRIPTS, "#161B22", "#58A6FF", dp(36), "BTN_SCRIPTS") { listener.onScriptsClicked() }
        subRow.addView(btnScripts)

        val btnSettings = createIconButton(VectorIconDrawer.IconType.SETTINGS, "#161B22", "#38BDF8", dp(36), "BTN_SETTINGS") { listener.onSettingsClicked() }
        subRow.addView(btnSettings)

        val btnJoystick = createIconButton(VectorIconDrawer.IconType.JOYSTICK, "#161B22", "#38BDF8", dp(36), "BTN_JOYSTICK") { listener.onJoystickClicked() }
        subRow.addView(btnJoystick)

        val btnLock = createIconButton(VectorIconDrawer.IconType.LOCK, "#161B22", "#38BDF8", dp(36), "BTN_LOCK") { listener.onScreenLockClicked() }
        subRow.addView(btnLock)

        val btnHide = object : View(context) {
            private val bounds = RectF()
            private val slashPaint = Paint(Paint.ANTI_ALIAS_FLAG).apply {
                color = Color.parseColor("#F04438")
                strokeWidth = dpF(2f)
                strokeCap = Paint.Cap.ROUND
            }
            override fun onDraw(canvas: Canvas) {
                super.onDraw(canvas)
                bounds.set(dpF(9f), dpF(9f), width - dpF(9f), height - dpF(9f))
                val iconColor = if (isNumbersHiddenState) Color.parseColor("#8B949E") else Color.parseColor("#00F5D4")
                VectorIconDrawer.drawIcon(canvas, VectorIconDrawer.IconType.VISIBILITY, bounds, iconColor, dpF(2.2f))
                if (isNumbersHiddenState) {
                    canvas.drawLine(bounds.left + dpF(2f), bounds.top + dpF(2f), bounds.right - dpF(2f), bounds.bottom - dpF(2f), slashPaint)
                }
            }
        }.apply {
            tag = "BTN_HIDE"
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor("#161B22"), Color.parseColor("#161B22"))
            ).apply {
                cornerRadius = dpF(8f)
                setStroke(dp(1), Color.parseColor("#00F5D4"))
            }
            elevation = dpF(4f)
            layoutParams = LinearLayout.LayoutParams(dp(31), dp(31)).apply { val m = dp(1); setMargins(m, m, m, m) }.apply {
                val m = dp(2)
                setMargins(m, m, m, m)
            }
            setOnClickListener { listener.onToggleNumbersClicked() }
        }
        btnHideRef = btnHide
        subRow.addView(btnHide)

        val btnClear = createIconButton(VectorIconDrawer.IconType.CLEAR, "#161B22", "#F04438", dp(36), "BTN_CLEAR") { listener.onClearAllClicked() }
        subRow.addView(btnClear)

        val btnLogs = createIconButton(VectorIconDrawer.IconType.LOGS, "#161B22", "#FFB703", dp(36), "BTN_LOGS") { 
            listener.onHelpClicked() 
        }
        subRow.addView(btnLogs)

        val btnTut = createIconButton(VectorIconDrawer.IconType.HELP, "#161B22", "#00F5D4", dp(36), "BTN_TUTORIAL") {
            applyDisplayMode(PanelDisplayMode.EXPANDED)
            InteractiveTutorialOverlay(
                context = context,
                overlayWindowManager = overlayWindowManager,
                mode = InteractiveTutorialOverlay.TutorialMode.CONTROL_PANEL,
                hostViewProvider = { rootView }
            ).show()
        }
        subRow.addView(btnTut)

        rootLinear.addView(subRow)
        container.addView(rootLinear)
    }

    private fun createIconButton(type: VectorIconDrawer.IconType, bgHex: String, iconHex: String, sizePx: Int, tagStr: String = "", onClick: () -> Unit): View {
        return object : View(context) {
            private val bounds = RectF()
            override fun onDraw(canvas: Canvas) {
                super.onDraw(canvas)
                bounds.set(dpF(9f), dpF(9f), width - dpF(9f), height - dpF(9f))
                VectorIconDrawer.drawIcon(canvas, type, bounds, Color.parseColor(iconHex), dpF(2.2f))
            }
        }.apply {
            tag = tagStr
            background = GradientDrawable(
                GradientDrawable.Orientation.TOP_BOTTOM,
                intArrayOf(Color.parseColor(bgHex), Color.parseColor("#161B22"))
            ).apply {
                cornerRadius = dpF(8f)
                setStroke(dp(1), Color.parseColor(iconHex))
            }
            elevation = dpF(4f)
            layoutParams = LinearLayout.LayoutParams(sizePx, sizePx).apply {
                val m = dp(2)
                setMargins(m, m, m, m)
            }
            setOnClickListener { onClick() }
        }
    }

    private fun attachDragListener(view: View) {
        view.setOnTouchListener(object : View.OnTouchListener {
            private var initX = 0
            private var initY = 0
            private var touchX = 0f
            private var touchY = 0f
            private var isMoved = false

            override fun onTouch(v: View, event: MotionEvent): Boolean {
                when (event.action) {
                    MotionEvent.ACTION_DOWN -> {
                        initX = posX
                        initY = posY
                        touchX = event.rawX
                        touchY = event.rawY
                        isMoved = false
                        return true
                    }
                    MotionEvent.ACTION_MOVE -> {
                        val dx = abs(event.rawX - touchX)
                        val dy = abs(event.rawY - touchY)
                        if (dx > 10 || dy > 10) {
                            isMoved = true
                            posX = (initX + (event.rawX - touchX).toInt()).coerceIn(0, dm.widthPixels - dp(50))
                            posY = (initY + (event.rawY - touchY).toInt()).coerceIn(0, dm.heightPixels - dp(50))
                            rootView?.let {
                                val lp = overlayWindowManager.createLayoutParams().apply {
                                    this.x = posX
                                    this.y = posY
                                }
                                overlayWindowManager.updateViewSafe(it, lp)
                            }
                        }
                        return true
                    }
                    MotionEvent.ACTION_UP -> {
                        if (!isMoved) {
                            v.performClick()
                        }
                        return true
                    }
                }
                return false
            }
        })
    }
}
