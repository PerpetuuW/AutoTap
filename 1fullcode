    override fun onAccessibilityEvent(event: AccessibilityEvent?) {
        val pkg = event?.packageName?.toString() ?: ""
        if (pkg.contains("settings") || pkg.contains("securitycenter")) {
            val prefs = getSharedPreferences("autotap_settings", Context.MODE_PRIVATE)
            val isFirstSettingsHighlight = prefs.getBoolean("first_settings_highlight", true)
            val delayMs = if (isFirstSettingsHighlight) 3000L else 350L

            Handler(Looper.getMainLooper()).postDelayed({
                scanAndHighlightSettingsNode(rootInActiveWindow)
                if (isFirstSettingsHighlight) {
                    prefs.edit { putBoolean("first_settings_highlight", false) }
                }
            }, delayMs)

            Handler(Looper.getMainLooper()).postDelayed({
                scanAndHighlightSettingsNode(rootInActiveWindow)
            }, delayMs + 500L)
        }
    }

    private fun scanAndHighlightSettingsNode(node: AccessibilityNodeInfo?) {
        if (node == null) return
        val rawText = (node.text?.toString() ?: "") + " " + (node.contentDescription?.toString() ?: "")
        val lowerText = rawText.lowercase(Locale.getDefault())

        if (lowerText.contains("запрещ") ||
            lowerText.contains("restricted") ||
            lowerText.contains("autotap") ||
            lowerText.contains("поверх") ||
            lowerText.contains("скачанные") ||
            lowerText.contains("установленные") ||
            lowerText.contains("огранич") ||
            lowerText.contains("draw over") ||
            lowerText.contains("display over")) {

            val rect = Rect()
            node.getBoundsInScreen(rect)
            if (!rect.isEmpty && rect.width() > 0 && rect.height() > 0) {
                showRedHighlightOverlay(rect.left, rect.top, rect.width(), rect.height())
                return
            }
        }
        for (i in 0 until node.childCount) {
            scanAndHighlightSettingsNode(node.getChild(i))
        }
    }

