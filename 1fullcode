            val isTrigger = selectedType == ActionType.TRIGGER
            val layoutAiBlock = dialogView.findViewById<View>(R.id.layoutAiParametersBlock)
            layoutAiBlock?.visibility = if (isTrigger) View.VISIBLE else View.GONE

            if (isTrigger) {
                updateDialogAiUI()
                if (globalTemplates.isEmpty()) {
                    tvTemplateIndex?.text = "Пул ИИ пуст!"
                } else {
                    tempTemplateIndex = tempTemplateIndex.coerceIn(0, globalTemplates.size - 1)

                    val fullPath = globalTemplatesNames[tempTemplateIndex]
                    val shortName = File(fullPath).nameWithoutExtension
                    val meta = loadTemplateMetadata(fullPath)
                    val pinnedPct = meta?.optInt("similarityPercent", config.similarityPercent) ?: config.similarityPercent
                    val isPinned = meta?.optBoolean("isPinned", true) ?: true

                    if (isPinned) {
                        config.similarityPercent = pinnedPct
                        etSimilarity?.setText(pinnedPct.toString())
                    }

                    tvTemplateIndex?.text = "$shortName (🎯 $pinnedPct%)"
                    etTemplateName?.setText(shortName)

                    val ivPreview = dialogView.findViewById<ImageView>(R.id.ivSelectedTemplateImagePreview)
                    if (tempTemplateIndex in globalTemplates.indices) {
                        ivPreview?.setImageBitmap(globalTemplates[tempTemplateIndex])
                    }
                }

                if (config.fullScreenshotPath.isNotEmpty() && File(config.fullScreenshotPath).exists()) {
                    layoutCropper?.visibility = View.VISIBLE
                    val fullBmp = BitmapFactory.decodeFile(config.fullScreenshotPath)
                    if (fullBmp != null) {
                        ivFullPreview?.setImageBitmap(fullBmp)
                        if (tempTemplateIndex in globalTemplates.indices) {
                            ivMaskPreview?.setImageBitmap(globalTemplates[tempTemplateIndex])
                        }

                        ivFullPreview?.setOnTouchListener { v, event ->
                            if (event.action == MotionEvent.ACTION_UP) {
                                v.performClick()
                                val viewW = v.width
                                val viewH = v.height
                                if (viewW > 0 && viewH > 0) {
                                    val bmpW = fullBmp.width
                                    val bmpH = fullBmp.height

                                    val scale = min(viewW.toFloat() / bmpW, viewH.toFloat() / bmpH)
                                    val actualW = bmpW * scale
                                    val actualH = bmpH * scale

                                    val leftOffset = (viewW - actualW) / 2f
                                    val topOffset = (viewH - actualH) / 2f

                                    val touchX = event.x - leftOffset
                                    val touchY = event.y - topOffset

                                    if (touchX in 0f..actualW && touchY in 0f..actualH) {
                                        val realX = (touchX / scale).toInt()
                                        val realY = (touchY / scale).toInt()

                                        val cropW = config.maskW.coerceIn(10, bmpW)
                                        val cropH = config.maskH.coerceIn(10, bmpH)
                                        val cropX = (realX - cropW / 2).coerceIn(0, (bmpW - cropW).coerceAtLeast(0))
                                        val cropY = (realY - cropH / 2).coerceIn(0, (bmpH - cropH).coerceAtLeast(0))

                                        val newIdx = saveFullAndCroppedTemplate(fullBmp, cropX, cropY, cropW, cropH, config)
                                        if (newIdx != -1) {
                                            tempTemplateIndex = newIdx
                                            ivMaskPreview?.setImageBitmap(globalTemplates[newIdx])
                                            updateUI()
                                            Toast.makeText(this@MyAutoClickService, "✂️ Маска перезахвачена!", Toast.LENGTH_SHORT).show()
                                        }
                                    }
                                }
                            }
                            true
                        }
                    } else {
                        layoutCropper?.visibility = View.GONE
                    }
                } else {
                    layoutCropper?.visibility = View.GONE
                }
            }
        }

