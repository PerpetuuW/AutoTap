    private fun getTemplateMetadataFile(maskPath: String): File {
        val maskFile = File(maskPath)
        val parent = maskFile.parentFile ?: filesDir
        val name = maskFile.nameWithoutExtension
        return File(parent, "${name}.json")
    }

    fun saveTemplateMetadata(maskPath: String, similarityPct: Int, isPinned: Boolean = true, localArea: Boolean = false) {
        try {
            if (maskPath.isEmpty()) return
            val metaFile = getTemplateMetadataFile(maskPath)
            val json = JSONObject().apply {
                put("similarityPercent", similarityPct)
                put("isPinned", isPinned)
                put("searchInCapturedArea", localArea)
            }
            FileOutputStream(metaFile).use { out ->
                out.write(json.toString().toByteArray())
            }
            logAppEvent(this, "META_SAVE", "Метаданные шаблона '${File(maskPath).nameWithoutExtension}' сохранены: $similarityPct%")
        } catch (e: Exception) {
            logError(this, e)
        }
    }

    fun loadTemplateMetadata(maskPath: String): JSONObject? {
        try {
            if (maskPath.isEmpty()) return null
            val metaFile = getTemplateMetadataFile(maskPath)
            if (metaFile.exists()) {
                return JSONObject(metaFile.readText())
            }
        } catch (_: Exception) {}
        return null
    }

    private fun purgeOldTrashTemplates() {
        try {
            val trashDir = File(filesDir, "trash_templates")
            if (trashDir.exists()) {
                val now = System.currentTimeMillis()
                val sevenDaysMs = 7L * 24 * 60 * 60 * 1000L
                trashDir.walkTopDown().forEach { file ->
                    if (file.isFile && (now - file.lastModified() > sevenDaysMs)) {
                        file.delete()
                    }
                }
                trashDir.listFiles()?.forEach { dir ->
                    if (dir.isDirectory && dir.listFiles()?.isEmpty() == true) {
                        dir.delete()
                    }
                }
            }
        } catch (e: Exception) {
            logError(this, e)
        }
    }

    fun moveTemplateToTrash(index: Int) {
        if (index !in globalTemplatesNames.indices) return
        try {
            val maskPath = globalTemplatesNames[index]
            val maskFile = File(maskPath)
            if (maskFile.exists()) {
                val dateFolder = maskFile.parentFile?.name ?: "default"
                val timestamp = maskFile.name.removePrefix("mask_").removeSuffix(".png")
                val fullFile = File(maskFile.parentFile, "full_${timestamp}.png")

                val targetTrashDir = File(File(filesDir, "trash_templates"), dateFolder).apply { mkdirs() }

                val trashMask = File(targetTrashDir, maskFile.name)
                maskFile.renameTo(trashMask)
                trashMask.setLastModified(System.currentTimeMillis())

                if (fullFile.exists()) {
                    val trashFull = File(targetTrashDir, fullFile.name)
                    fullFile.renameTo(trashFull)
                    trashFull.setLastModified(System.currentTimeMillis())
                }
            }

            globalTemplates.removeAt(index)
            globalTemplatesNames.removeAt(index)

            for (act in actionsList) {
                act.multiTemplateIndices.remove(index)
                for (k in act.multiTemplateIndices.indices) {
                    if (act.multiTemplateIndices[k] > index) {
                        act.multiTemplateIndices[k] = act.multiTemplateIndices[k] - 1
                    }
                }
                if (act.selectedTemplateIndex == index) {
                    act.selectedTemplateIndex = if (globalTemplates.isNotEmpty()) 0 else -1
                } else if (act.selectedTemplateIndex > index) {
                    act.selectedTemplateIndex = act.selectedTemplateIndex - 1
                }
            }

            Toast.makeText(this, "🗑 Шаблон перемещен в корзину", Toast.LENGTH_SHORT).show()
        } catch (e: Exception) {
            logError(this, e)
        }
    }

