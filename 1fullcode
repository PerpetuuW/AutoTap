            btnTypeSwipe.backgroundTintList = ColorStateList.valueOf(getColor(if (selectedType == ActionType.SWIPE) R.color.accent_blue else R.color.bg_dark_blue))
            btnTypeTrigger.backgroundTintList = ColorStateList.valueOf(getColor(if (selectedType == ActionType.TRIGGER) R.color.accent_blue else R.color.bg_dark_blue))

            val isHold = selectedType == ActionType.LONG_PRESS
            tvHoldTitle?.visibility = if (isHold) View.VISIBLE else View.GONE
