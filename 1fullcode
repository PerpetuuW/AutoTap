            WindowManager.LayoutParams.MATCH_PARENT,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        )

        var downX = 0f
        var downY = 0f
        var downTime = 0L

        recordOverlayView?.setOnTouchListener { v, event ->
            if (!isRecording || isInjectingGesture) return@setOnTouchListener false

            val x = event.rawX
            val y = event.rawY

            when (event.action) {
                MotionEvent.ACTION_DOWN -> {
                    downX = x
                    downY = y
                    downTime = System.currentTimeMillis()
                    logAppEvent(this, "RECORD_TOUCH_DOWN", "Палец коснулся экрана на ($downX, $downY)")
                    return@setOnTouchListener true
                }
                MotionEvent.ACTION_UP -> {
                    v.performClick()
                    val dist = hypot((x - downX).toDouble(), (y - downY).toDouble())
                    val delay = if (actionsList.isEmpty()) 1000L else (downTime - lastRecordedTime).coerceAtLeast(100L)
                    lastRecordedTime = downTime

                    isInjectingGesture = true

                    fun setOverlayTouchable(touchable: Boolean) {
                        recordOverlayView?.let { rView ->
                            (rView.layoutParams as? WindowManager.LayoutParams)?.let { lp ->
                                if (touchable) {
                                    lp.flags = lp.flags and WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE.inv()
                                } else {
                                    lp.flags = lp.flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                                }
                                safeUpdateViewLayout(rView, lp)
                            }
                        }
                    }

                    if (dist > 60) {
                        logAppEvent(this, "RECORD_SWIPE", "Записан свайп от ($downX, $downY) к ($x, $y)")
                        addNewActionAtPosition(downX, downY, delay, ActionType.SWIPE, -1)
                        val currentConfig = actionsList.last()
                        spawnEndTargetAtPosition(currentConfig, x, y)

                        setOverlayTouchable(false)
                        Handler(Looper.getMainLooper()).postDelayed({
                            performSwipeWithCallback(downX, downY, x, y) {
                                setOverlayTouchable(true)
                                isInjectingGesture = false
                            }
                        }, 80L)
                    } else {
                        logAppEvent(this, "RECORD_CLICK", "Записан клик в точку ($downX, $downY)")
                        addNewActionAtPosition(downX, downY, delay, ActionType.CLICK, -1)

                        setOverlayTouchable(false)
                        Handler(Looper.getMainLooper()).postDelayed({
                            performClickWithCallback(downX, downY) {
                                setOverlayTouchable(true)
                                isInjectingGesture = false
                            }
                        }, 80L)
                    }
                    return@setOnTouchListener true
                }
            }
            false
        }

        safeAddView(recordOverlayView, overlayParams)
        showRecordBar()
    }

    private fun stopOverlayRecording() {
        isRecording = false
        isInjectingGesture = false

        if (recordOverlayView != null) {
