        btnCancel.setOnClickListener { safeRemoveView(dialogView) }
        safeAddView(dialogView, params)
    }

    fun performClick(x: Float, y: Float, duration: Long = globalClickDurationMs) {
        performClickWithCallback(x, y, duration)
    }

    fun performClickWithCallback(x: Float, y: Float, duration: Long = globalClickDurationMs, onComplete: (() -> Unit)? = null) {
        spawnClickRippleAnimation(x, y)
        val path = Path().apply { moveTo(x, y) }
        val stroke = GestureDescription.StrokeDescription(path, 0, duration)
        val gesture = GestureDescription.Builder().addStroke(stroke).build()
        dispatchGesture(gesture, object : GestureResultCallback() {
            override fun onCompleted(gestureDescription: GestureDescription?) {
                super.onCompleted(gestureDescription)
                logAppEvent(this@MyAutoClickService, "GESTURE_SUCCESS", "✅ Системный жест успешно выполнен на ($x, $y)")
                onComplete?.invoke()
            }
            override fun onCancelled(gestureDescription: GestureDescription?) {
                super.onCancelled(gestureDescription)
                logAppEvent(this@MyAutoClickService, "GESTURE_CANCELLED", "⚠️ Системный жест отклонен ОС Android (помеха/экран заблокирован)")
                onComplete?.invoke()
            }
        }, null)
    }

    fun performSwipe(startX: Float, startY: Float, endX: Float, endY: Float, duration: Long = globalSwipeDurationMs) {
        performSwipeWithCallback(startX, startY, endX, endY, duration)
    }

    fun performSwipeWithCallback(startX: Float, startY: Float, endX: Float, endY: Float, duration: Long = globalSwipeDurationMs, onComplete: (() -> Unit)? = null) {
        spawnClickRippleAnimation(startX, startY)
        val path = Path().apply {
            moveTo(startX, startY)
            lineTo(endX, endY)
        }
        val stroke = GestureDescription.StrokeDescription(path, 0, duration)
        val gesture = GestureDescription.Builder().addStroke(stroke).build()
        dispatchGesture(gesture, object : GestureResultCallback() {
            override fun onCompleted(gestureDescription: GestureDescription?) {
                super.onCompleted(gestureDescription)
                logAppEvent(this@MyAutoClickService, "GESTURE_SUCCESS", "✅ Системный жест успешно выполнен")
                onComplete?.invoke()
            }
            override fun onCancelled(gestureDescription: GestureDescription?) {
                super.onCancelled(gestureDescription)
                logAppEvent(this@MyAutoClickService, "GESTURE_CANCELLED", "⚠️ Системный жест отклонен ОС Android (помеха/экран заблокирован)")
                onComplete?.invoke()
            }
        }, null)
    }

    fun exportScriptWithTemplates(context: Context, scriptName: String) {
        try {
            val scriptsDir = File(context.filesDir, "scripts")
            val scriptFile = File(scriptsDir, "$scriptName.json")
            if (!scriptFile.exists()) {
                Toast.makeText(context, "Файл сценария не найден!", Toast.LENGTH_SHORT).show()
                return
            }

            val zipFile = File(context.externalCacheDir ?: context.cacheDir, "$scriptName.zip")
            val zos = ZipOutputStream(FileOutputStream(zipFile))

            val jsonBytes = scriptFile.readBytes()
            val jsonEntry = ZipEntry("scripts/$scriptName.json")
            zos.putNextEntry(jsonEntry)
            zos.write(jsonBytes)
            zos.closeEntry()

            val jsonArray = JSONArray(String(jsonBytes))
            val addedPaths = HashSet<String>()

            for (i in 0 until jsonArray.length()) {
                val obj = jsonArray.getJSONObject(i)
                val tPath = if (obj.has("templatePath")) obj.getString("templatePath") else ""
                val fPath = if (obj.has("fullScreenshotPath")) obj.getString("fullScreenshotPath") else ""

                listOf(tPath, fPath).forEach { path ->
                    if (path.isNotEmpty() && !addedPaths.contains(path)) {
                        val imgFile = File(path)
                        if (imgFile.exists()) {
                            addedPaths.add(path)
                            val entryName = "templates/${imgFile.parentFile?.name ?: "default"}/${imgFile.name}"
                            val imgEntry = ZipEntry(entryName)
                            zos.putNextEntry(imgEntry)
                            zos.write(imgFile.readBytes())
                            zos.closeEntry()

                            val metaFile = getTemplateMetadataFile(path)
                            if (metaFile.exists()) {
                                val metaEntryName = "templates/${imgFile.parentFile?.name ?: "default"}/${metaFile.name}"
                                val metaEntry = ZipEntry(metaEntryName)
                                zos.putNextEntry(metaEntry)
                                zos.write(metaFile.readBytes())
                                zos.closeEntry()
                            }
                        }
                    }
                }
            }
            zos.close()

            val builder = StrictMode.VmPolicy.Builder()
            StrictMode.setVmPolicy(builder.build())

            val uri = try {
                FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", zipFile)
            } catch (_: Exception) {
                Uri.fromFile(zipFile)
            }
            val shareIntent = Intent(Intent.ACTION_SEND).apply {
                type = "application/zip"
                putExtra(Intent.EXTRA_SUBJECT, "Сценарий AutoTap: $scriptName")
                putExtra(Intent.EXTRA_STREAM, uri)
                addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
            }
            val chooserIntent = Intent.createChooser(shareIntent, "Экспортировать сценарий").apply {
                addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
            }
            context.startActivity(chooserIntent)
            logAppEvent(context, "SCRIPT_EXPORT", "Сценарий '$scriptName' успешно экспортирован в ZIP!")
        } catch (e: Exception) {
            logError(context, e)
            Toast.makeText(context, "Ошибка экспорта сценария!", Toast.LENGTH_SHORT).show()
        }
    }

