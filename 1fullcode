        return (dp * resources.displayMetrics.density).toInt()
    }

    private fun convertToSoftwareBitmap(hardwareBitmap: Bitmap): Bitmap {
        return try {
            hardwareBitmap.copy(Bitmap.Config.ARGB_8888, false) ?: run {
                val softwareBitmap = createBitmap(hardwareBitmap.width, hardwareBitmap.height)
                val canvas = Canvas(softwareBitmap)
                canvas.drawBitmap(hardwareBitmap, 0f, 0f, null)
                softwareBitmap
            }
        } catch (_: Exception) {
            val softwareBitmap = createBitmap(hardwareBitmap.width, hardwareBitmap.height)
            val canvas = Canvas(softwareBitmap)
            canvas.drawBitmap(hardwareBitmap, 0f, 0f, null)
            softwareBitmap
        }
    }

    private fun getOverlayType(): Int {
        return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.O) {
            WindowManager.LayoutParams.TYPE_ACCESSIBILITY_OVERLAY
        } else {
            WindowManager.LayoutParams.TYPE_PHONE
        }
    }

    private val automationRunnable: Runnable = object : Runnable {
        override fun run() {
            if (!isPlaying || actionsList.isEmpty()) return

            if (currentActionIndex >= actionsList.size) {
                currentActionIndex = 0
                stepRepeatCounter = 0
            }

            highlightActiveStep(currentActionIndex)
            val config = actionsList[currentActionIndex]

            if (config.type == ActionType.TRIGGER && config.selectedTemplateIndex != -1 && config.selectedTemplateIndex < globalTemplates.size) {
                checkTriggerAndProceed(config) {
                    stepRepeatCounter++
                    if (config.repeatCount == -1 || stepRepeatCounter < config.repeatCount) {
                        loopHandler.postDelayed(automationRunnable, config.delay)
                    } else {
                        proceedToNextAction(config)
                    }
                }
            } else {
                stepRepeatCounter++
                executeAction(config)
                if (config.repeatCount == -1 || stepRepeatCounter < config.repeatCount) {
                    loopHandler.postDelayed(automationRunnable, config.delay)
                } else {
                    proceedToNextAction(config)
                }
            }
        }
    }

    private fun proceedToNextAction(config: ActionConfig) {
        stepRepeatCounter = 0
        aiStepStartTimeMs = 0L
        val nextIdx = currentActionIndex + 1

        loopHandler.removeCallbacks(automationRunnable)

        if (nextIdx >= actionsList.size && nextScriptOnFinish.isNotEmpty()) {
            logAppEvent(this, "SCRIPT_CHAIN", "🔗 Сценарий завершен. Авто-эстафета к сценарию '$nextScriptOnFinish'")
            val scriptToRun = nextScriptOnFinish
            loadScriptByName(scriptToRun)
            if (actionsList.isNotEmpty() && isPlaying) {
                currentActionIndex = 0
                loopHandler.postDelayed(automationRunnable, config.delay)
                return
            }
        }

        if (actionsList.isEmpty()) return
        currentActionIndex = nextIdx % actionsList.size
        loopHandler.postDelayed(automationRunnable, config.delay)
    }

    private fun executeAction(config: ActionConfig) {
        val startLoc = IntArray(2)
        config.startView.getLocationOnScreen(startLoc)

        val offsetX = if (config.randomRadius > 0) Random.nextInt(-config.randomRadius, config.randomRadius + 1) else 0
        val offsetY = if (config.randomRadius > 0) Random.nextInt(-config.randomRadius, config.randomRadius + 1) else 0

        val startX = startLoc[0].toFloat() + config.startView.width / 2f + offsetX
        val startY = startLoc[1].toFloat() + config.startView.height / 2f + offsetY

        when (config.type) {
            ActionType.SWIPE -> {
                if (config.endView != null) {
                    val endLoc = IntArray(2)
                    config.endView!!.getLocationOnScreen(endLoc)
                    val endX = endLoc[0].toFloat() + config.endView!!.width / 2f
                    val endY = endLoc[1].toFloat() + config.endView!!.height / 2f
                    performSwipe(startX, startY, endX, endY)
                }
            }
            ActionType.LONG_PRESS -> {
                performClick(startX, startY, duration = config.holdDuration)
            }
            else -> {
                performClick(startX, startY, duration = globalClickDurationMs)
            }
        }
    }

    private fun checkTriggerAndProceed(config: ActionConfig, onMatched: () -> Unit) {
        if (aiStepStartTimeMs == 0L) {
            aiStepStartTimeMs = System.currentTimeMillis()
        }

        if (config.aiTimeoutSeconds > 0) {
            val elapsedSec = (System.currentTimeMillis() - aiStepStartTimeMs) / 1000L
            if (elapsedSec >= config.aiTimeoutSeconds) {
                logAppEvent(this, "AI_TIMEOUT", "⌛ Таймаут ИИ (${config.aiTimeoutSeconds} сек) истек для шага #${config.id}! Переход к следующему шагу.")
                Toast.makeText(this, "⌛ Таймаут шага #${config.id} (${config.aiTimeoutSeconds}с) -> След. шаг", Toast.LENGTH_SHORT).show()
                aiStepStartTimeMs = 0L
                proceedToNextAction(config)
                return
            }
        }

        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            val targetDisplayId = try {
                this.display?.displayId ?: Display.DEFAULT_DISPLAY
            } catch (_: Exception) {
                Display.DEFAULT_DISPLAY
            }

            takeScreenshot(targetDisplayId, uiExecutor, object : TakeScreenshotCallback {
                override fun onSuccess(screenshot: ScreenshotResult) {
                    if (!isPlaying) {
                        try { screenshot.hardwareBuffer.close() } catch(_: Exception){}
                        return
                    }

                    val ignoredRects = ArrayList<Rect>()
                    controlPanelView?.let { panel ->
                        val loc = IntArray(2)
                        panel.getLocationOnScreen(loc)
                        if (panel.width > 0 && panel.height > 0) {
                            ignoredRects.add(Rect(loc[0], loc[1], loc[0] + panel.width, loc[1] + panel.height))
                        }
                    }
                    for (act in actionsList) {
                        act.startView.let { v ->
                            val loc = IntArray(2)
                            v.getLocationOnScreen(loc)
                            if (v.width > 0 && v.height > 0) {
                                ignoredRects.add(Rect(loc[0], loc[1], loc[0] + v.width, loc[1] + v.height))
                            }
                        }
                        act.endView?.let { v ->
                            val loc = IntArray(2)
                            v.getLocationOnScreen(loc)
                            if (v.width > 0 && v.height > 0) {
                                ignoredRects.add(Rect(loc[0], loc[1], loc[0] + v.width, loc[1] + v.height))
                            }
                        }
                    }

                    bgScannerExecutor.execute {
                        try {
                            val hwBuffer = screenshot.hardwareBuffer
                            val colorSpace = screenshot.colorSpace
                            val fullBitmap = Bitmap.wrapHardwareBuffer(hwBuffer, colorSpace)
                            try {
                                hwBuffer.close()
                            } catch (_: Exception) {}

                            if (fullBitmap != null) {
                                val softwareBitmap = convertToSoftwareBitmap(fullBitmap)

                                val templatesToScan = ArrayList<Int>()
                                if (config.multiTemplateIndices.isNotEmpty()) {
                                    templatesToScan.addAll(config.multiTemplateIndices)
                                } else if (config.selectedTemplateIndex != -1 && config.selectedTemplateIndex in globalTemplates.indices) {
                                    templatesToScan.add(config.selectedTemplateIndex)
                                } else if (globalTemplates.isNotEmpty()) {
                                    templatesToScan.add(globalTemplates.size - 1)
                                }

                                var matchedPoint: Point? = null
                                var matchedTemplateIdx = -1

                                val searchRect = if (config.searchInCapturedArea && config.maskW > 0 && config.maskH > 0) {
                                    val margin = 140
                                    Rect(
                                        (config.maskX - margin).coerceAtLeast(0),
                                        (config.maskY - margin).coerceAtLeast(0),
                                        (config.maskX + config.maskW + margin).coerceAtMost(softwareBitmap.width),
                                        (config.maskY + config.maskH + margin).coerceAtMost(softwareBitmap.height)
                                    )
                                } else null

                                try {
                                    var highestScore = 0f
                                    for (tIdx in templatesToScan) {
                                        if (tIdx in globalTemplates.indices) {
                                            val tBmp = globalTemplates[tIdx]
                                            val maskPath = if (tIdx in globalTemplatesNames.indices) globalTemplatesNames[tIdx] else ""
                                            val meta = loadTemplateMetadata(maskPath)
                                            val tThreshold = (meta?.optInt("similarityPercent", config.similarityPercent) ?: config.similarityPercent) / 100f
                                            val candidate = findTemplateMatchCandidate(softwareBitmap, tBmp, tThreshold, ignoredRects, searchRect, config.semiTransparentMode)
                                            if (candidate != null) {
                                                if (config.bestMatchAuto) {
                                                    if (candidate.ratio > highestScore) {
                                                        highestScore = candidate.ratio
                                                        matchedPoint = candidate.point
                                                        matchedTemplateIdx = tIdx
                                                    }
                                                } else {
                                                    matchedPoint = candidate.point
                                                    matchedTemplateIdx = tIdx
                                                    break
                                                }
                                            }
                                        }
                                    }
                                } finally {
                                    softwareBitmap.recycle()
                                }

                                val matchPoint = matchedPoint
                                Handler(Looper.getMainLooper()).post {
                                    if (matchPoint != null) {
                                        val realX = matchPoint.x.toFloat()
                                        val realY = matchPoint.y.toFloat()
                                        val templateName = if (matchedTemplateIdx in globalTemplatesNames.indices) File(globalTemplatesNames[matchedTemplateIdx]).nameWithoutExtension else "#$matchedTemplateIdx"

                                        val screenH = fullBitmap.height
                                        val zoneText = when {
                                            realY < screenH * 0.35f -> "Верхняя область (Шапка)"
                                            realY < screenH * 0.70f -> "Средняя область (Контент/Баннер)"
                                            else -> "Нижняя область (Подвал/Баннер)"
                                        }

                                        if (config.playAudioOnMatch) playMatchSound()
                                        logAppEvent(this@MyAutoClickService, "AI_MATCH", "🎯 Совпадение! Найден '$templateName' на ($realX, $realY) [$zoneText]")
                                        if (config.targetScriptToLoad.isNotEmpty()) {
                                            logAppEvent(this@MyAutoClickService, "SCRIPT_CHAIN", "🎯 ИИ-триггер сработал! Загрузка связанного сценария '${config.targetScriptToLoad}'")
                                            val nextScript = config.targetScriptToLoad
                                            loadScriptByName(nextScript)
                                            if (actionsList.isNotEmpty() && isPlaying) {
                                                currentActionIndex = 0
                                                stepRepeatCounter = 0
                                                aiStepStartTimeMs = 0L
                                                loopHandler.removeCallbacks(automationRunnable)
                                                loopHandler.postDelayed(automationRunnable, config.delay)
                                                return@post
                                            }
                                        }

                                        if (config.clickAiTarget) {
                                            logAppEvent(this@MyAutoClickService, "AI_CLICK_EXEC", "👉 ИИ Клик отправлен в точку ($realX, $realY)")
                                            performClick(realX, realY)
                                        } else {
                                            logAppEvent(this@MyAutoClickService, "AI_CLICK_EXEC", "👉 ИИ Триггер сработал: клик в ручную мишень")
                                            executeAction(config)
                                        }

                                        if (config.jumpToStepOnMatch != -1) {
                                            stepRepeatCounter = 0
                                            aiStepStartTimeMs = 0L
                                            currentActionIndex = (config.jumpToStepOnMatch - 1).coerceIn(0, actionsList.size - 1)
                                            loopHandler.removeCallbacks(automationRunnable)
                                            loopHandler.postDelayed(automationRunnable, config.delay)
                                            return@post
                                        }

                                        aiStepStartTimeMs = 0L
                                        onMatched()
                                    } else {
                                        if (isPlaying) {
                                            loopHandler.postDelayed({ checkTriggerAndProceed(config, onMatched) }, config.checkInterval)
                                        }
                                    }
                                }
                                return@execute
                            }
                        } catch (e: Exception) {
                            logError(this@MyAutoClickService, e)
                        }

                        Handler(Looper.getMainLooper()).post {
                            if (isPlaying) {
                                loopHandler.postDelayed({ checkTriggerAndProceed(config, onMatched) }, config.checkInterval)
                            }
                        }
                    }
                }

                override fun onFailure(errorCode: Int) {
                    if (isPlaying) {
                        loopHandler.postDelayed({ checkTriggerAndProceed(config, onMatched) }, config.checkInterval)
                    }
                }
            })
        } else {
            aiStepStartTimeMs = 0L
            onMatched()
        }
    }

    private fun findTemplateMatchCandidate(
        screen: Bitmap,
        template: Bitmap,
        thresholdRatio: Float = 0.80f,
        ignoredRects: List<Rect> = emptyList(),
        cropSearchRect: Rect? = null,
        isSemiTransparent: Boolean = false
    ): MatchCandidate? {
        val sW = screen.width
        val sH = screen.height
        val tW = template.width
        val tH = template.height
        if (tW > sW || tH > sH) return null

        val screenPixels = IntArray(sW * sH)
        val templatePixels = IntArray(tW * tH)

        screen.getPixels(screenPixels, 0, sW, 0, 0, sW, sH)
        template.getPixels(templatePixels, 0, tW, 0, 0, tW, tH)

        val isSmallIcon = tW < 45 || tH < 45
        val isLargeIcon = tW > 120 || tH > 120

        val denseStep = when {
            isSmallIcon -> 1
            isLargeIcon -> 4
            else -> 2
        }

        val maxColorDiff = when {
            thresholdRatio >= 0.92f -> 8
            thresholdRatio >= 0.85f -> 12
            thresholdRatio >= 0.78f -> 16
            thresholdRatio >= 0.70f -> 20
            else -> 26
        }

        var validTemplatePixels = 0
        val featureIndices = IntArray(tW * tH)
        var featureCount = 0

        for (ty in 0 until tH step denseStep) {
            val tRow = ty * tW
            for (tx in 0 until tW step denseStep) {
                val tCol = templatePixels[tRow + tx]
                if ((tCol ushr 24) >= 50) {
                    validTemplatePixels++
                    if (tx % (denseStep * 2) == 0 && ty % (denseStep * 2) == 0) {
                        featureIndices[featureCount++] = tRow + tx
                    }
                }
            }
        }
        if (validTemplatePixels == 0) return null

        val requiredMatches = (validTemplatePixels * thresholdRatio).toInt()

        val startX = cropSearchRect?.left?.coerceIn(0, (sW - tW).coerceAtLeast(0)) ?: 0
        val endX = cropSearchRect?.right?.coerceIn(startX, (sW - tW).coerceAtLeast(0)) ?: (sW - tW)
        val defaultStartY = if (sH > 600) 40 else 0
        val startY = cropSearchRect?.top?.coerceIn(0, (sH - tH).coerceAtLeast(0)) ?: defaultStartY
        val endY = cropSearchRect?.bottom?.coerceIn(startY, (sH - tH).coerceAtLeast(0)) ?: (sH - tH)

        var bestCandidate: MatchCandidate? = null
        var maxRatio = 0f

        val isLargeSearchArea = (endX - startX) * (endY - startY) > 200000
        val coarseStep = if (isLargeSearchArea && !isSmallIcon) 4 else denseStep

        for (y in startY..endY step coarseStep) {
            for (x in startX..endX step coarseStep) {
                val centerX = x + tW / 2
                val centerY = y + tH / 2

                var inIgnored = false
                for (r in ignoredRects) {
                    if (r.contains(centerX, centerY)) {
                        inIgnored = true
                        break
                    }
                }
                if (inIgnored) continue

                if (!isSemiTransparent && featureCount > 4) {
                    var anchorFailures = 0
                    val maxAnchorFailures = (featureCount * (1.0f - thresholdRatio)).toInt()
                    for (i in 0 until featureCount) {
                        val fIdx = featureIndices[i]
                        val fx = fIdx % tW
                        val fy = fIdx / tW
                        val tCol = templatePixels[fIdx]
                        val sCol = screenPixels[(y + fy) * sW + x + fx]

                        val sr = (sCol shr 16) and 0xff
                        val sg = (sCol shr 8) and 0xff
                        val sb = sCol and 0xff
                        val tr = (tCol shr 16) and 0xff
                        val tg = (tCol shr 8) and 0xff
                        val tb = tCol and 0xff

                        val wDiff = (abs(sr - tr) * 0.30f + abs(sg - tg) * 0.59f + abs(sb - tb) * 0.11f)
                        if (wDiff > maxColorDiff) {
                            anchorFailures++
                            if (anchorFailures > maxAnchorFailures) break
                        }
                    }
                    if (anchorFailures > maxAnchorFailures) continue
                }

                var matches = 0
                var failures = 0
                val maxFailures = validTemplatePixels - requiredMatches

                for (ty in 0 until tH - 1 step denseStep) {
                    val sRow = (y + ty) * sW + x
                    val tRow = ty * tW
                    for (tx in 0 until tW - 1 step denseStep) {
                        val tCol = templatePixels[tRow + tx]
                        if ((tCol ushr 24) < 50) continue

                        val sCol = screenPixels[sRow + tx]
                        val sr = (sCol shr 16) and 0xff
                        val sg = (sCol shr 8) and 0xff
                        val sb = sCol and 0xff

                        val tr = (tCol shr 16) and 0xff
                        val tg = (tCol shr 8) and 0xff
                        val tb = tCol and 0xff

                        if (isSemiTransparent) {
                            val tColRight = templatePixels[tRow + tx + 1]
                            val sColRight = screenPixels[sRow + tx + 1]

                            val tLuma = (tr * 30 + tg * 59 + tb * 11) / 100
                            val tLumaR = (((tColRight shr 16) and 0xff) * 30 + ((tColRight shr 8) and 0xff) * 59 + (tColRight and 0xff) * 11) / 100
                            val tGrad = abs(tLuma - tLumaR)

                            val sLuma = (sr * 30 + sg * 59 + sb * 11) / 100
                            val sLumaR = (((sColRight shr 16) and 0xff) * 30 + ((sColRight shr 8) and 0xff) * 59 + (sColRight and 0xff) * 11) / 100
                            val sGrad = abs(sLuma - sLumaR)

                            if (tGrad > 15) {
                                if (sGrad >= (tGrad * 0.45f)) matches++ else failures++
                            } else {
                                matches++
                            }
                        } else {
                            val weightedDiff = (abs(sr - tr) * 0.30f + abs(sg - tg) * 0.59f + abs(sb - tb) * 0.11f)
                            if (weightedDiff <= maxColorDiff) {
                                matches++
                            } else {
                                failures++
                            }
                        }

                        if (failures > maxFailures) break
                    }
                    if (failures > maxFailures) break
                }

                if (matches >= requiredMatches) {
                    val ratio = matches.toFloat() / validTemplatePixels
                    if (ratio > maxRatio) {
                        maxRatio = ratio
                        bestCandidate = MatchCandidate(Point(centerX, centerY), ratio, Rect(x, y, x + tW, y + tH))
                    }
                }
            }
        }
        return bestCandidate
    }

    private fun findAllTemplateMatches(
        screen: Bitmap,
        template: Bitmap,
        minRatio: Float = 0.50f,
        ignoredRects: List<Rect> = emptyList(),
        cropSearchRect: Rect? = null
    ): List<MatchCandidate> {
        val sW = screen.width
        val sH = screen.height
        val tW = template.width
        val tH = template.height
        if (tW > sW || tH > sH) return emptyList()

        val screenPixels = IntArray(sW * sH)
        val templatePixels = IntArray(tW * tH)

        screen.getPixels(screenPixels, 0, sW, 0, 0, sW, sH)
        template.getPixels(templatePixels, 0, tW, 0, 0, tW, tH)

        val isSmallIcon = tW < 45 || tH < 45
        val isLargeIcon = tW > 120 || tH > 120
        val scanStep = when {
            isSmallIcon -> 1
            isLargeIcon -> 4
            else -> 2
        }

        val maxColorDiff = when {
            minRatio >= 0.92f -> 8
            minRatio >= 0.85f -> 12
            minRatio >= 0.78f -> 16
            else -> 22
        }

        var validTemplatePixels = 0
        for (ty in 0 until tH step scanStep) {
            val tRow = ty * tW
            for (tx in 0 until tW step scanStep) {
                val tCol = templatePixels[tRow + tx]
                if ((tCol ushr 24) >= 50) validTemplatePixels++
            }
        }
        if (validTemplatePixels == 0) return emptyList()

        val startX = cropSearchRect?.left?.coerceIn(0, (sW - tW).coerceAtLeast(0)) ?: 0
        val endX = cropSearchRect?.right?.coerceIn(startX, (sW - tW).coerceAtLeast(0)) ?: (sW - tW)
        val defaultStartY = if (sH > 600) 40 else 0
        val startY = cropSearchRect?.top?.coerceIn(0, (sH - tH).coerceAtLeast(0)) ?: defaultStartY
        val endY = cropSearchRect?.bottom?.coerceIn(startY, (sH - tH).coerceAtLeast(0)) ?: (sH - tH)

        val rawCandidates = ArrayList<MatchCandidate>()

        for (y in startY..endY step scanStep) {
            for (x in startX..endX step scanStep) {
                val centerX = x + tW / 2
                val centerY = y + tH / 2

                var inIgnored = false
                for (r in ignoredRects) {
                    if (r.contains(centerX, centerY)) {
                        inIgnored = true
                        break
                    }
                }
                if (inIgnored) continue

                var matches = 0
                var failures = 0
                val maxFailures = (validTemplatePixels * (1.0f - minRatio)).toInt()

                for (ty in 0 until tH step scanStep) {
                    val sRow = (y + ty) * sW + x
                    val tRow = ty * tW
                    for (tx in 0 until tW step scanStep) {
                        val tCol = templatePixels[tRow + tx]
                        if ((tCol ushr 24) < 50) continue

                        val sCol = screenPixels[sRow + tx]
                        val sr = (sCol shr 16) and 0xff
                        val sg = (sCol shr 8) and 0xff
                        val sb = sCol and 0xff

                        val tr = (tCol shr 16) and 0xff
                        val tg = (tCol shr 8) and 0xff
                        val tb = tCol and 0xff

                        if (abs(sr - tr) <= maxColorDiff && abs(sg - tg) <= maxColorDiff && abs(sb - tb) <= maxColorDiff) {
                            matches++
                        } else {
                            failures++
                            if (failures > maxFailures) break
                        }
                    }
                    if (failures > maxFailures) break
                }

                val ratio = matches.toFloat() / validTemplatePixels
                if (ratio >= minRatio) {
                    rawCandidates.add(MatchCandidate(Point(centerX, centerY), ratio, Rect(x, y, x + tW, y + tH)))
                }
            }
        }

        rawCandidates.sortByDescending { it.ratio }
        val result = ArrayList<MatchCandidate>()
        val minDist = (maxOf(tW, tH) * 0.7f).coerceAtLeast(30f)

        for (cand in rawCandidates) {
            var tooClose = false
            for (existing in result) {
                val dist = hypot((cand.point.x - existing.point.x).toDouble(), (cand.point.y - existing.point.y).toDouble())
                if (dist < minDist) {
                    tooClose = true
                    break
                }
            }
            if (!tooClose) {
                result.add(cand)
                if (result.size >= 8) break
            }
        }

        return result
    }

    private fun startTemplateCalibration(config: ActionConfig, onFinished: () -> Unit) {
        if (config.selectedTemplateIndex !in globalTemplates.indices) {
            Toast.makeText(this, "Сначала выберите шаблон ИИ!", Toast.LENGTH_SHORT).show()
            onFinished()
            return
        }

        val templateBmp = globalTemplates[config.selectedTemplateIndex]
        val templateName = if (config.selectedTemplateIndex in globalTemplatesNames.indices) File(globalTemplatesNames[config.selectedTemplateIndex]).nameWithoutExtension else "#${config.selectedTemplateIndex}"
        logAppEvent(this, "AI_CALIBRATE_START", "🔍 Запуск калибровки для '$templateName' (${templateBmp.width}x${templateBmp.height}px)")

        val ignoredRects = ArrayList<Rect>()
        controlPanelView?.let { panel ->
            val loc = IntArray(2)
            panel.getLocationOnScreen(loc)
            if (panel.width > 0 && panel.height > 0) {
                ignoredRects.add(Rect(loc[0], loc[1], loc[0] + panel.width, loc[1] + panel.height))
            }
        }
        controlPanelView?.visibility = View.GONE
        for (act in actionsList) {
            act.startView.visibility = View.GONE
            act.endView?.visibility = View.GONE
        }

        var isCalibHandled = false
        val calibTimeoutRunnable = Runnable {
            if (!isCalibHandled) {
                isCalibHandled = true
                logAppEvent(this@MyAutoClickService, "AI_CALIBRATE_TIMEOUT", "⚠️ Таймаут калибровки (7 сек). Восстановление видов.")
                Toast.makeText(this@MyAutoClickService, "⌛ Таймаут калибровки (панель восстановлена)", Toast.LENGTH_SHORT).show()
                showAllViews()
                onFinished()
            }
        }
        screenshotHandler.postDelayed(calibTimeoutRunnable, globalPreScreenshotDelayMs + 7000L)

        screenshotHandler.postDelayed({
            if (isCalibHandled) return@postDelayed
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                val targetDisplayId = try {
                    this.display?.displayId ?: Display.DEFAULT_DISPLAY
                } catch (_: Exception) {
                    Display.DEFAULT_DISPLAY
                }

                takeScreenshot(targetDisplayId, uiExecutor, object : TakeScreenshotCallback {
                    override fun onSuccess(screenshot: ScreenshotResult) {
                        val hwBuffer = screenshot.hardwareBuffer
                        val colorSpace = screenshot.colorSpace
                        val fullBitmap = Bitmap.wrapHardwareBuffer(hwBuffer, colorSpace)
                        try { hwBuffer.close() } catch (_: Exception) {}

                        if (fullBitmap == null) {
                            showAllViews()
                            Toast.makeText(this@MyAutoClickService, "Ошибка захвата экрана", Toast.LENGTH_SHORT).show()
                            onFinished()
                            return
                        }

                        val softwareBitmap = convertToSoftwareBitmap(fullBitmap)
                        logAppEvent(this@MyAutoClickService, "AI_CALIBRATE_SHOT", "📷 Чистый снимок экрана получен (${softwareBitmap.width}x${softwareBitmap.height}px)")

                        bgScannerExecutor.execute {
                            try {
                                val candidates = findAllTemplateMatches(softwareBitmap, templateBmp, minRatio = 0.50f, ignoredRects = ignoredRects)
                                softwareBitmap.recycle()

                                Handler(Looper.getMainLooper()).post {
                                    showAllViews()
                                    if (candidates.isEmpty()) {
                                        logAppEvent(this@MyAutoClickService, "AI_CALIBRATE_EMPTY", "⚠️ Совпадений от 50% не найдено.")
                                        Toast.makeText(this@MyAutoClickService, "❌ Совпадений от 50% не найдено!", Toast.LENGTH_LONG).show()
                                    } else {
                                        logAppEvent(this@MyAutoClickService, "AI_CALIBRATE_RESULT", "🎯 УСПЕХ: Найдено вариантов совпадений: ${candidates.size}")
                                        displayCalibrationCandidatesOverlay(config, candidates, onFinished)
                                    }
                                }
                            } catch (e: Exception) {
                                logError(this@MyAutoClickService, e)
                                logAppEvent(this@MyAutoClickService, "AI_CALIBRATE_ERROR", "❌ Ошибка калибровки: ${e.message}")
                                Handler(Looper.getMainLooper()).post {
                                    showAllViews()
                                    onFinished()
                                    Toast.makeText(this@MyAutoClickService, "Ошибка калибровки!", Toast.LENGTH_SHORT).show()
                                }
                            }
                        }
                    }

                    override fun onFailure(errorCode: Int) {
                        showAllViews()
                        Toast.makeText(this@MyAutoClickService, "Ошибка скриншота ОС ($errorCode)", Toast.LENGTH_SHORT).show()
                        onFinished()
                    }
                })
            } else {
                showAllViews()
                Toast.makeText(this, "Калибровка доступна на Android 11+", Toast.LENGTH_SHORT).show()
                onFinished()
            }
        }, globalPreScreenshotDelayMs)
    }

    private fun displayCalibrationCandidatesOverlay(
        config: ActionConfig,
        candidates: List<MatchCandidate>,
        onFinished: () -> Unit
    ) {
        clearCalibrationOverlay()

        val topBarView = LinearLayout(this).apply {
            orientation = LinearLayout.HORIZONTAL
            gravity = Gravity.CENTER_VERTICAL
            setBackgroundColor(Color.parseColor("#E60D1117"))
            setPadding(dpToPx(12), dpToPx(8), dpToPx(12), dpToPx(8))
        }

        val tvInfo = TextView(this).apply {
            text = "🎯 Найдено совпадений: ${candidates.size}. Кликните на рамку для выбора %:"
            setTextColor(Color.WHITE)
            textSize = 12f
            setTypeface(null, Typeface.BOLD)
            layoutParams = LinearLayout.LayoutParams(0, LinearLayout.LayoutParams.WRAP_CONTENT, 1f)
        }

        val btnCancel = Button(this).apply {
            text = "✕ Закрыть"
            setTextColor(Color.WHITE)
            textSize = 11f
            backgroundTintList = ColorStateList.valueOf(getColor(R.color.red_close))
            setOnClickListener {
                clearCalibrationOverlay()
                onFinished()
            }
        }

        topBarView.addView(tvInfo)
        topBarView.addView(btnCancel)

        val topBarParams = WindowManager.LayoutParams(
            WindowManager.LayoutParams.MATCH_PARENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_TOUCH_MODAL or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN,
            PixelFormat.TRANSLUCENT
        ).apply {
            gravity = Gravity.TOP
            y = dpToPx(30)
        }

        safeAddView(topBarView, topBarParams)
        calibrationViewsList.add(topBarView)

        for (cand in candidates) {
            val pct = (cand.ratio * 100).toInt()

            val strokeColor = when {
                pct >= 80 -> Color.parseColor("#00F5D4")
                pct >= 65 -> Color.parseColor("#FFB703")
                else -> Color.parseColor("#F04438")
            }

            val boxView = LayoutInflater.from(this).inflate(R.layout.floating_calibration_box, null)
            val tvPct = boxView.findViewById<TextView>(R.id.tvCandidatePercent)
            val frameBox = boxView.findViewById<View>(R.id.viewCandidateBorder)

            tvPct.text = "🎯 $pct%"
            tvPct.setTextColor(strokeColor)

            val borderDrawable = GradientDrawable().apply {
                shape = GradientDrawable.RECTANGLE
                setColor(Color.parseColor("#20000000"))
                setStroke(dpToPx(3), strokeColor)
                cornerRadius = dpToPx(8).toFloat()
            }
            frameBox.background = borderDrawable

            val boxW = maxOf(cand.rect.width(), dpToPx(44))
            val boxH = maxOf(cand.rect.height(), dpToPx(44))

            val boxParams = WindowManager.LayoutParams(
                boxW,
                boxH,
                getOverlayType(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                PixelFormat.TRANSLUCENT
            ).apply {
                gravity = Gravity.TOP or Gravity.START
                x = cand.rect.left
                y = cand.rect.top
            }

            boxView.setOnClickListener {
                config.similarityPercent = pct
                config.bestMatchAuto = false
                config.maskX = cand.rect.left
                config.maskY = cand.rect.top
                config.maskW = cand.rect.width()
                config.maskH = cand.rect.height()

                if (config.selectedTemplateIndex in globalTemplatesNames.indices) {
                    val maskPath = globalTemplatesNames[config.selectedTemplateIndex]
                    saveTemplateMetadata(maskPath, pct, isPinned = true, localArea = config.searchInCapturedArea)
                }

                logAppEvent(this, "AI_CALIBRATE_PIN", "Закреплено совпадение $pct% в точке (${cand.point.x}, ${cand.point.y})")
                Toast.makeText(this, "🎯 Совпадение $pct% закреплено!", Toast.LENGTH_SHORT).show()

                spawnClickRippleAnimation(cand.point.x.toFloat(), cand.point.y.toFloat())

                clearCalibrationOverlay()
                onFinished()
            }

            safeAddView(boxView, boxParams)
            calibrationViewsList.add(boxView)
        }
    }

