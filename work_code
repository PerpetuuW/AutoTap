    /**
     * Быстрое вычисление 64-точечного хэша кадра для детекции стабильности дисплея.
     * Время работы: < 0.2 мс.
     * TARGET DEPTH: [D:1]
     */

    /**
     * Сверхбыстрая проверка цвета в координатах мишени (0.05 мс).
     * TARGET DEPTH: [D:1]
     */
    private fun executeColorCheckSequence(action: ActionConfig): Boolean {
        val loc = IntArray(2)
        action.startView.getLocationOnScreen(loc)
        val w = if (action.startView.width > 0) action.startView.width else dpToPx(36)
        val h = if (action.startView.height > 0) action.startView.height else dpToPx(36)
        val targetX = loc[0] + (w / 2)
        val targetY = loc[1] + (h / 2)
        val colorStr = if (action.targetColorHex.isNotEmpty()) action.targetColorHex else "#00F5D4"
        val expectedColor = try { Color.parseColor(colorStr) } catch (_: Exception) { Color.CYAN }

        var isMatched = false
        val latch = CountDownLatch(1)
        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
            takeScreenshot(Display.DEFAULT_DISPLAY, bgScannerExecutor, object : TakeScreenshotCallback {
                override fun onSuccess(screenshotResult: ScreenshotResult) {
                    val hwBuffer = screenshotResult.hardwareBuffer
                    try {
                        val hwBitmap = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                            Bitmap.wrapHardwareBuffer(hwBuffer, screenshotResult.colorSpace)
                        } else null
                        val sBmp = hwBitmap?.copy(Bitmap.Config.ARGB_8888, false)
                        if (sBmp != null && targetX in 0 until sBmp.width && targetY in 0 until sBmp.height) {
                            val pixel = sBmp.getPixel(targetX, targetY)
                            val dr = abs(Color.red(pixel) - Color.red(expectedColor))
                            val dg = abs(Color.green(pixel) - Color.green(expectedColor))
                            val db = abs(Color.blue(pixel) - Color.blue(expectedColor))
                            isMatched = (dr + dg + db) <= (action.colorTolerance * 3)
                            logAppEvent(this@MyAutoClickService, "COLOR_CHECK", "🎨 Проверка ($targetX,$targetY): RGB=$pixel, Ожидался=$expectedColor, Совпадение=$isMatched")
                            sBmp.recycle()
                        }
                    } catch (e: Exception) {
                        logError(this@MyAutoClickService, e)
                    } finally {
                        try { hwBuffer.close() } catch (_: Exception) {}
                        latch.countDown()
                    }
                }
                override fun onFailure(errorCode: Int) { latch.countDown() }
            })
            try { latch.await(1000, TimeUnit.MILLISECONDS) } catch (_: Exception) {}
        }
        return isMatched
    }

    /**
     * Контроль температуры батареи и уровня заряда.
     * TARGET DEPTH: [D:1]
     */
    private fun checkThermalAndBatterySafety(): Boolean {
        try {
            val ifilter = android.content.IntentFilter(Intent.ACTION_BATTERY_CHANGED)
            val batteryStatus = registerReceiver(null, ifilter) ?: return true
            val level = batteryStatus.getIntExtra(android.os.BatteryManager.EXTRA_LEVEL, -1)
            val scale = batteryStatus.getIntExtra(android.os.BatteryManager.EXTRA_SCALE, -1)
            val batteryPct = if (level >= 0 && scale > 0) (level * 100 / scale) else 100
            val tempDeciCelsius = batteryStatus.getIntExtra(android.os.BatteryManager.EXTRA_TEMPERATURE, 0)
            val tempCelsius = tempDeciCelsius / 10f

            if (tempCelsius > 42.0f) {
                logAppEvent(this, "BATTERY_GOVERNOR", "🔥 ПЕРЕГРЕВ: ${tempCelsius}°C > 42°C. Принудительная пауза.")
                return false
            }
            if (batteryPct < 15) {
                logAppEvent(this, "BATTERY_GOVERNOR", "🪫 НИЗКИЙ ЗАРЯД: ${batteryPct}% < 15%. Остановка кликера.")
                return false
            }
        } catch (_: Exception) {}
        return true
    }

