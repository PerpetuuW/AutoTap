    private val overlayWatchdogHandler = Handler(Looper.getMainLooper())
    private val restoreControlPanelRunnable = Runnable {
        if (controlPanelView != null && controlPanelView?.visibility != View.VISIBLE) {
            logAppEvent(
                this,
                "OVERLAY_SAFETY",
                "⚠️ Сторожевой таймер оверлея! Принудительное восстановление панели управления."
            )
            controlPanelView?.alpha = 1.0f
            controlPanelView?.visibility = View.VISIBLE
        }
    }

    fun hideControlPanelTemporarily(timeoutMs: Long = 30000L) {
        uiExecutor.execute {
            dismissJoystick()
            controlPanelView?.alpha = 0.01f
            controlPanelView?.let { panel ->
                val lp = panel.layoutParams as? WindowManager.LayoutParams
                if (lp != null) {
                    lp.flags = lp.flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                    safeUpdateViewLayout(panel, lp)
                }
            }
            overlayWatchdogHandler.removeCallbacks(restoreControlPanelRunnable)
            overlayWatchdogHandler.postDelayed(restoreControlPanelRunnable, timeoutMs)
        }
    }

    fun restoreControlPanelImmediately() {
        uiExecutor.execute {
            overlayWatchdogHandler.removeCallbacks(restoreControlPanelRunnable)
            controlPanelView?.alpha = 1.0f
            controlPanelView?.visibility = View.VISIBLE
            controlPanelView?.let { panel ->
                val lp = panel.layoutParams as? WindowManager.LayoutParams
                if (lp != null) {
                    lp.flags = lp.flags and WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE.inv()
                    safeUpdateViewLayout(panel, lp)
                }
            }
        }
    }

