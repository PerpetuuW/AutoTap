class ClickPulseView @JvmOverloads constructor(
    context: Context,
    attrs: android.util.AttributeSet? = null,
    defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr) {
    var onFinishedCallback: (() -> Unit)? = null

    private val ringPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.STROKE
        strokeWidth = 6f
        color = "#00F5D4".toColorInt()
    }
    private val corePaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.FILL
        color = Color.WHITE
    }
    private val crosshairPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.STROKE
        strokeWidth = 4f
        color = "#00F5D4".toColorInt()
    }

    private var startTime = -1L
    private val durationMs = 380f

    init {
        setWillNotDraw(false)
        setLayerType(LAYER_TYPE_HARDWARE, null)
    }

    override fun onAttachedToWindow() {
        super.onAttachedToWindow()
        startTime = System.currentTimeMillis()
        invalidate()

        android.os.Handler(android.os.Looper.getMainLooper()).postDelayed({
            if (isAttachedToWindow) {
                onFinishedCallback?.invoke()
            }
        }, durationMs.toLong())
    }

    override fun onDraw(canvas: android.graphics.Canvas) {
        super.onDraw(canvas)

        if (startTime == -1L) {
            startTime = System.currentTimeMillis()
        }

        val elapsed = System.currentTimeMillis() - startTime
        val progress = (elapsed / durationMs).coerceIn(0f, 1f)

        val cx = width / 2f
        val cy = height / 2f
        val maxRadius = ((width / 2f) - 8f).coerceAtLeast(10f)

        val interpolatedProgress = 1f - (1f - progress) * (1f - progress)

        val ringRadius = maxRadius * interpolatedProgress
        ringPaint.alpha = ((1f - interpolatedProgress) * 255).toInt().coerceIn(0, 255)
        canvas.drawCircle(cx, cy, ringRadius, ringPaint)

        if (interpolatedProgress < 0.65f) {
            val coreProgress = interpolatedProgress / 0.65f
            val coreRadius = (maxRadius * 0.28f) * (1f - coreProgress)
            corePaint.alpha = ((1f - coreProgress) * 255).toInt().coerceIn(0, 255)
            canvas.drawCircle(cx, cy, coreRadius, corePaint)
        }

        val chLen = 14f * (1f - interpolatedProgress)
        val chDist = ringRadius + 4f
        crosshairPaint.alpha = ((1f - interpolatedProgress) * 220).toInt().coerceIn(0, 255)
        if (chDist < width / 2f) {
            canvas.drawLine(cx, cy - chDist, cx, cy - chDist - chLen, crosshairPaint)
            canvas.drawLine(cx, cy + chDist, cx, cy + chDist + chLen, crosshairPaint)
            canvas.drawLine(cx - chDist, cy, cx - chDist - chLen, cy, crosshairPaint)
            canvas.drawLine(cx + chDist, cy, cx + chDist + chLen, cy, crosshairPaint)
        }

        if (progress < 1f) {
            postInvalidateOnAnimation()
        }
    }
}

class GraphOverlayView @JvmOverloads constructor(
    context: Context,
    attrs: android.util.AttributeSet? = null,
    defStyleAttr: Int = 0
) : View(context, attrs, defStyleAttr) {

    private val matchPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.STROKE
        strokeWidth = 4.5f
        color = "#10B981".toColorInt()
        pathEffect = android.graphics.DashPathEffect(floatArrayOf(16f, 10f), 0f)
    }

    private val timeoutPaint = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.STROKE
        strokeWidth = 4.5f
        color = "#F97316".toColorInt()
        pathEffect = android.graphics.DashPathEffect(floatArrayOf(16f, 10f), 0f)
    }

    private val arrowFillMatch = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.FILL
        color = "#10B981".toColorInt()
    }

    private val arrowFillTimeout = android.graphics.Paint(android.graphics.Paint.ANTI_ALIAS_FLAG).apply {
        style = android.graphics.Paint.Style.FILL
        color = "#F97316".toColorInt()
    }

        private val reusableCurvePath = Path()
    private val reusableHeadPath = Path()
    private val loc1 = IntArray(2)
    private val loc2 = IntArray(2)

    init {
        setWillNotDraw(false)
        setLayerType(LAYER_TYPE_HARDWARE, null)
    }

    override fun onDraw(canvas: android.graphics.Canvas) {
        super.onDraw(canvas)
        val service = MyAutoClickService.instance ?: return
        val actions = service.getActionsListSnapshot()
        if (actions.size < 2) return


        for (action in actions) {
            action.startView.getLocationOnScreen(loc1)
            val size1 = if (action.startView.width > 0) action.startView.width else 36
            val x1 = loc1[0] + size1 / 2f
            val y1 = loc1[1] + size1 / 2f

            if (action.jumpToStepOnMatch in 1..actions.size && action.jumpToStepOnMatch != action.id) {
                val target = actions[action.jumpToStepOnMatch - 1]
                target.startView.getLocationOnScreen(loc2)
                val size2 = if (target.startView.width > 0) target.startView.width else 36
                val x2 = loc2[0] + size2 / 2f
                val y2 = loc2[1] + size2 / 2f
                drawCurvedArrow(canvas, x1, y1, x2, y2, matchPaint, arrowFillMatch, 50f)
            }

            if (action.jumpToStepOnTimeout in 1..actions.size && action.jumpToStepOnTimeout != action.id) {
                val target = actions[action.jumpToStepOnTimeout - 1]
                target.startView.getLocationOnScreen(loc2)
                val size2 = if (target.startView.width > 0) target.startView.width else 36
                val x2 = loc2[0] + size2 / 2f
                val y2 = loc2[1] + size2 / 2f
                drawCurvedArrow(canvas, x1, y1, x2, y2, timeoutPaint, arrowFillTimeout, -50f)
            }
        }
    }

    private fun drawCurvedArrow(
        canvas: android.graphics.Canvas,
        x1: Float, y1: Float, x2: Float, y2: Float,
        linePaint: android.graphics.Paint,
        arrowPaint: android.graphics.Paint,
        curvature: Float
    ) {
        val dx = x2 - x1
        val dy = y2 - y1
        val dist = kotlin.math.hypot(dx.toDouble(), dy.toDouble()).toFloat()
        if (dist < 12f) return

        val normX = -dy / dist
        val normY = dx / dist
        val midX = (x1 + x2) / 2f + normX * curvature
        val midY = (y1 + y2) / 2f + normY * curvature

        reusableCurvePath.rewind()
        reusableCurvePath.moveTo(x1, y1)
        reusableCurvePath.quadTo(midX, midY, x2, y2)
        canvas.drawPath(reusableCurvePath, linePaint)

        val angle = kotlin.math.atan2((y2 - midY).toDouble(), (x2 - midX).toDouble())
        val arrowHeadLen = 22f
        val arrowAngle = Math.PI / 6.0
        val p1X = (x2 - arrowHeadLen * kotlin.math.cos(angle - arrowAngle)).toFloat()
        val p1Y = (y2 - arrowHeadLen * kotlin.math.sin(angle - arrowAngle)).toFloat()
        val p2X = (x2 - arrowHeadLen * kotlin.math.cos(angle + arrowAngle)).toFloat()
        val p2Y = (y2 - arrowHeadLen * kotlin.math.sin(angle + arrowAngle)).toFloat()

        reusableHeadPath.rewind()
        reusableHeadPath.moveTo(x2, y2)
        reusableHeadPath.lineTo(p1X, p1Y)
        reusableHeadPath.lineTo(p2X, p2Y)
        reusableHeadPath.close()
        canvas.drawPath(reusableHeadPath, arrowPaint)
    }
}

