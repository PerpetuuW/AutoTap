    fun dismissJoystick() {
        uiExecutor.execute {
            isInjectingJoystickGesture = false
            emergencyReleaseActiveJoystickStroke()
            joystickOverlayView?.let { safeRemoveView(it); joystickOverlayView = null }
            joystickTargetView?.let { safeRemoveView(it); joystickTargetView = null }
            setOverlaysVisibleForCapture(true)
            restoreControlPanelImmediately()
        }
    }

    private fun stopActionScanningVisual() {
        uiExecutor.execute {
            activeScanningAnimator?.cancel()
            activeScanningAnimator = null

            activeScanningView?.let { view ->
                view.animate().cancel()
                view.alpha = 1.0f
                if (activeScanningOriginalBg != null) {
                    view.background = activeScanningOriginalBg
                } else {
                    view.background = AppCompatResources.getDrawable(this@MyAutoClickService, R.drawable.circle_target)
                }
            }
            activeScanningView = null
            activeScanningOriginalBg = null

            if (scanningHUDView != null) {
                safeRemoveView(scanningHUDView)
                scanningHUDView = null
            }
        }
    }

    fun exportLogsToTxtFile(context: Context) {
        try {
            val logFile = File(context.filesDir, "error_log.txt")
            if (logFile.exists() && logFile.length() > 0) {
                val uri = androidx.core.content.FileProvider.getUriForFile(context, "${context.packageName}.fileprovider", logFile)
                val shareIntent = Intent(Intent.ACTION_SEND).apply {
                    type = "text/plain"
                    putExtra(Intent.EXTRA_STREAM, uri)
                    putExtra(Intent.EXTRA_SUBJECT, "AutoTap Diagnostic Log")
                    addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION or Intent.FLAG_ACTIVITY_NEW_TASK)
                }
                val chooser = Intent.createChooser(shareIntent, "Экспорт логов AutoTap (.txt)").apply {
                    addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
                }
                context.startActivity(chooser)
            } else {
                Toast.makeText(context, "Лог-файл пуст!", Toast.LENGTH_SHORT).show()
            }
        } catch (e: Exception) {
            logError(context, e)
            Toast.makeText(context, "Ошибка экспорта лога: ${e.message}", Toast.LENGTH_SHORT).show()
        }
    }

    companion object {
        private var serviceRef: WeakReference<MyAutoClickService>? = null
        private val logLock = Any()

        @JvmStatic
        var instance: MyAutoClickService?
            get() = serviceRef?.get()
            set(value) {
                serviceRef = if (value != null) WeakReference(value) else null
            }

        @JvmStatic
        fun logError(context: Context, e: Throwable) {
            android.util.Log.e("AutoTap", "Caught Exception", e)
            synchronized(logLock) {
                try {
                    val logFile = File(context.filesDir, "error_log.txt")
                    if (logFile.exists() && logFile.length() > 512 * 1024) {
                        val tailContent = logFile.readText().takeLast(256 * 1024)
                        logFile.writeText("...[АВТО-ОЧИСТКА СТАРЫХ ЛОГОВ]...\n" + tailContent)
                    }
                    val sdf = SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.getDefault())
                    val sw = java.io.StringWriter()
                    e.printStackTrace(PrintWriter(sw))
                    val line = "=== ${sdf.format(Date())} EXCEPTION ===\n$sw\n"
                    logFile.appendText(line, Charsets.UTF_8)
                } catch (_: Exception) {
                }
            }
        }

        @JvmStatic
        fun logAppEvent(context: Context, tag: String, message: String) {
            android.util.Log.d("AutoTap", "[$tag] $message")
            synchronized(logLock) {
                try {
                    val logFile = File(context.filesDir, "error_log.txt")
                    if (logFile.exists() && logFile.length() > 512 * 1024) {
                        val tailContent = logFile.readText().takeLast(256 * 1024)
                        logFile.writeText("...[АВТО-ОЧИСТКА СТАРЫХ ЛОГОВ]...\n" + tailContent)
                    }

                    val sdf = SimpleDateFormat("yyyy-MM-dd HH:mm:ss.SSS", Locale.getDefault())
                    val line = "[${sdf.format(Date())}][$tag] $message\n"
                    logFile.appendText(line, Charsets.UTF_8)
                } catch (_: Exception) {
                }
            }
        }
    }

