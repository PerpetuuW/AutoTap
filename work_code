    private fun startExecutionLoop() {
        if (executionThread != null) return
        acquireWakeLock()
        uiExecutor.execute {
            setOverlaysVisibleForCapture(false)
            showRunningBadge()
            Toast.makeText(this@MyAutoClickService, "Запущено (Громкость - или значок для СТОП)", Toast.LENGTH_SHORT).show()
        }
        executionThread = Thread {
            var currentIndex = 0
            while (isPlaying && actionsList.isNotEmpty()) {
                if (currentIndex >= actionsList.size) currentIndex = 0
                val action = actionsList.getOrNull(currentIndex) ?: break
                val repeats = if (action.repeatCount <= 0) Int.MAX_VALUE else action.repeatCount

                if (isStepByStepDebug) {
                    debugStepLatch = CountDownLatch(1)
                    val stepped = try {
                        debugStepLatch?.await(60, TimeUnit.SECONDS) ?: false
                    } catch (_: Exception) { false }
                    if (!stepped && isPlaying) {
                        uiExecutor.execute {
                            Toast.makeText(this@MyAutoClickService, "⏱ Таймаут отладчика (60с). Авто-пауза.", Toast.LENGTH_SHORT).show()
                            stopExecutionLoop()
                        }
                        break
                    }
                    if (!isPlaying) break
                }

                for (r in 0 until repeats) {
                    if (!isPlaying) break
                    // Мониторинг защиты от перегрева и разряда батареи
                    if (!checkThermalAndBatterySafety()) {
                        isPlaying = false // Синхронный сброс для остановки внешнего while-цикла!
                        uiExecutor.execute {
                            Toast.makeText(this@MyAutoClickService, "⚠️ Авто-пауза: Защита батареи от перегрева (>41°C) / разряда (<15%)", Toast.LENGTH_LONG).show()
                            stopExecutionLoop()
                        }
                        break
                    }


                    try {
                        val jitter = if (action.randomRadius > 0) kotlin.random.Random.nextLong(-action.delay / 10, action.delay / 10 + 1) else 0L
                        val safeDelay = (action.delay + jitter).coerceAtLeast(20L)
                        Thread.sleep(safeDelay)
                    } catch (e: InterruptedException) {
                        break
                    }
                    if (!isPlaying) break

                    when (action.type) {
                        ActionType.CLICK -> {
                            var clickX = 0f;
                            var clickY = 0f
                            val latch = CountDownLatch(1)
                            uiExecutor.execute {
                                val loc = IntArray(2)
                                action.startView.getLocationOnScreen(loc)
                                val size =
                                    if (action.startView.width > 0) action.startView.width else (36 * resources.displayMetrics.density).toInt()
                                val dm = resources.displayMetrics
                                val (gOffX, gOffY) = computeGaussianOffset(action.randomRadius)
                                val rawX = loc[0] + size / 2f + gOffX
                                val rawY = loc[1] + size / 2f + gOffY
                                clickX = rawX.coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                clickY = rawY.coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                latch.countDown()
                            }
                            try {
                                latch.await(600, TimeUnit.MILLISECONDS)
                            } catch (_: Exception) {
                            }
                            showClickVisualizer(clickX, clickY)
                            performClick(clickX, clickY, globalClickDurationMs)
                        }

                        ActionType.LONG_PRESS -> {
                            var clickX = 0f;
                            var clickY = 0f
                            val latch = CountDownLatch(1)
                            uiExecutor.execute {
                                val loc = IntArray(2)
                                action.startView.getLocationOnScreen(loc)
                                val size =
                                    if (action.startView.width > 0) action.startView.width else (36 * resources.displayMetrics.density).toInt()
                                val dm = resources.displayMetrics
                                clickX = (loc[0] + size / 2f).coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                clickY = (loc[1] + size / 2f).coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                latch.countDown()
                            }
                            try {
                                latch.await(600, TimeUnit.MILLISECONDS)
                            } catch (_: Exception) {
                            }
                            showClickVisualizer(clickX, clickY)
                            performClick(clickX, clickY, action.holdDuration)
                        }

                        ActionType.SWIPE -> {
                            if (action.endView != null) {
                                var startX = 0f;
                                var startY = 0f;
                                var endX = 0f;
                                var endY = 0f
                                val latch = CountDownLatch(1)
                                uiExecutor.execute {
                                    val loc1 = IntArray(2)
                                    action.startView.getLocationOnScreen(loc1)
                                    val loc2 = IntArray(2)
                                    action.endView!!.getLocationOnScreen(loc2)
                                    val size =
                                        if (action.startView.width > 0) action.startView.width else (36 * resources.displayMetrics.density).toInt()
                                    val dm = resources.displayMetrics
                                    startX = (loc1[0] + size / 2f).coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                    startY = (loc1[1] + size / 2f).coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                    endX = (loc2[0] + size / 2f).coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                    endY = (loc2[1] + size / 2f).coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                    latch.countDown()
                                }
                                try {
                                    latch.await(600, TimeUnit.MILLISECONDS)
                                } catch (_: Exception) {
                                }
                                val dm = resources.displayMetrics
                                val humanGesture = HumanGestureEngine.buildHumanSwipeGesture(
                                    startX, startY, endX, endY,
                                    action.holdDuration.coerceAtLeast(120L),
                                    dm.widthPixels, dm.heightPixels
                                )
                                dispatchGesture(humanGesture, null, null)
                                statsHudView?.recordClick()
                            }
                        }

                        ActionType.PATH -> {
                            if (action.pathPoints.isNotEmpty()) {
                                val dm = resources.displayMetrics
                                val builder = GestureDescription.Builder()
                                val path = Path()
                                val firstP = action.pathPoints.first()
                                val safeStartX = firstP.x.coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                val safeStartY = firstP.y.coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                path.moveTo(safeStartX, safeStartY)
                                for (i in 1 until action.pathPoints.size) {
                                    val pt = action.pathPoints[i]
                                    val safePx = pt.x.coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                                    val safePy = pt.y.coerceIn(0f, dm.heightPixels.toFloat() - 1f)
                                    path.lineTo(safePx, safePy)
                                }
                                val gestureDuration = action.holdDuration.coerceIn(100L, 10000L)
                                val stroke = GestureDescription.StrokeDescription(
                                    path,
                                    0L,
                                    gestureDuration
                                )
                                builder.addStroke(stroke)
                                val gestureLatch = CountDownLatch(1)
                                dispatchGesture(builder.build(), object : GestureResultCallback() {
                                    override fun onCompleted(gestureDescription: GestureDescription?) {
                                        gestureLatch.countDown()
                                    }
                                    override fun onCancelled(gestureDescription: GestureDescription?) {
                                        gestureLatch.countDown()
                                    }
                                }, null)
                                try { gestureLatch.await(gestureDuration + 300L, TimeUnit.MILLISECONDS) } catch (_: Exception) {}
                                statsHudView?.recordClick()
                            }
                        }

                        ActionType.OCR -> {
                            val query = action.targetScriptToLoad.trim()
                            val matched = if (query.contains(Regex("[<>=!]"))) {
                                evaluateLogicCondition(query)
                            } else {
                                executeOcrSearchSequence(action)
                            }
                            if (matched && action.jumpToStepOnMatch in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnMatch - 1
                                continue
                            } else if (!matched && action.jumpToStepOnTimeout in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnTimeout - 1
                                continue
                            }
                        }
                        ActionType.TRIGGER -> {
                            val oldTimeout = action.aiTimeoutSeconds
                            if (action.isWaitUntilMode && action.aiTimeoutSeconds < 15) action.aiTimeoutSeconds = 30
                            val matched = if (action.isWaitUntilMode && action.repeatCount == 0) {
                                executeWaitUntilDisappearSequence(action, action.aiTimeoutSeconds)
                            } else if (action.multiTemplateIndices.size > 1 && action.targetScriptToLoad.startsWith("LOGIC:")) {
                                executeCompositeAiCondition(action)
                            } else {
                                executeAiTriggerSequence(action)
                            }
                            if (matched && action.jumpToStepOnMatch in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnMatch - 1
                                continue
                            } else if (!matched && action.jumpToStepOnTimeout in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnTimeout - 1
                                continue
                            }
                        }
                        ActionType.COLOR_CHECK -> {
                            val matched = executeColorCheckSequence(action)
                            if (matched && action.jumpToStepOnMatch in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnMatch - 1
                                continue
                            } else if (!matched && action.jumpToStepOnTimeout in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnTimeout - 1
                                continue
                            }
                        }
                        ActionType.SUBROUTINE -> {
                            val targetTag = action.targetScriptToLoad.trim()
                            val targetIdx = actionsList.indexOfFirst { it.subroutineTag.equals(targetTag, ignoreCase = true) }
                            if (targetIdx != -1) {
                                if (subroutineCallStack.size > 50) {
                                    uiExecutor.execute { Toast.makeText(this@MyAutoClickService, "⚠️ ОШИБКА: Бесконечный цикл подпрограмм!", Toast.LENGTH_LONG).show() }
                                    logAppEvent(this, "ERROR", "Стек подпрограмм переполнен (>50). Принудительная остановка.")
                                    break
                                }
                                subroutineCallStack.push(currentIndex + 1)
                                logAppEvent(this, "SUBROUTINE", "🔀 CALL: Подпрограмма '$targetTag' на Шаг #${targetIdx + 1} (Возврат на #${currentIndex + 2})")
                                currentIndex = targetIdx
                                continue
                            } else if (action.jumpToStepOnMatch in 1..actionsList.size) {
                                currentIndex = action.jumpToStepOnMatch - 1
                                continue
                            }
                        }
                        ActionType.RETURN -> {
                            if (subroutineCallStack.isNotEmpty()) {
                                val returnIdx = subroutineCallStack.pop()
                                logAppEvent(this, "SUBROUTINE", "↩️ RETURN: Возврат из подпрограммы на Шаг #${returnIdx + 1}")
                                currentIndex = returnIdx
                                continue
                            } else {
                                logAppEvent(this, "SUBROUTINE", "⚠️ Стек вызовов пуст, завершение цикла.")
                                break
                            }
                        }
                    }
                }
                if (actionsList.isNotEmpty()) {
                    currentIndex = (currentIndex + 1) % actionsList.size
                } else {
                    break
                }
            }
            isPlaying = false
            uiExecutor.execute {
                stopActionScanningVisual()
                hideRunningBadge()
                setOverlaysVisibleForCapture(true)
                val playBtn = controlPanelView?.let { findViewByName<ImageButton>(it, "btnPlay") }
                playBtn?.setImageResource(R.drawable.ic_play)
            }
        }
        executionThread?.start()
    }

