    private fun removeActionAndReindex(config: ActionConfig) {
        val deletedId = config.id
        safeRemoveView(config.startView)
        config.endView?.let { safeRemoveView(it) }
        actionsList.remove(config)

        for ((i, act) in actionsList.withIndex()) {
            act.id = i + 1
            act.startView.findViewById<TextView>(R.id.tvTargetNumber)?.text = act.id.toString()
            act.endView?.findViewById<TextView>(R.id.tvTargetNumberEnd)?.text = "${act.id}E"

            // Пересчет ссылок ветвления
            if (act.jumpToStepOnMatch == deletedId) {
                act.jumpToStepOnMatch = -1
            } else if (act.jumpToStepOnMatch > deletedId) {
                act.jumpToStepOnMatch--
            }

            if (act.jumpToStepOnTimeout == deletedId) {
                act.jumpToStepOnTimeout = -1
            } else if (act.jumpToStepOnTimeout > deletedId) {
                act.jumpToStepOnTimeout--
            }
        }
        requestGraphRedraw()
    }

