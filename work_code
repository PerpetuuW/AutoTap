            config.repeatCount =
                etRepeatCount?.text?.toString()?.toIntOrNull()?.coerceAtLeast(1) ?: 1
            config.jumpToStepOnMatch = etJumpOnMatch?.text?.toString()?.toIntOrNull() ?: -1
            config.jumpToStepOnTimeout = etJumpOnTimeout?.text?.toString()?.toIntOrNull() ?: -1
            if (selectedType == ActionType.OCR) {
                config.targetScriptToLoad = etOcrQuery?.text?.toString()?.trim() ?: "OK"
            } else if (selectedType == ActionType.SUBROUTINE) {
                val tag = etOcrQuery?.text?.toString()?.trim() ?: "SUB_1"
                config.targetScriptToLoad = tag
                config.subroutineTag = tag
            } else if (selectedType == ActionType.COLOR_CHECK) {
