    private fun computeFastScreenHash(pixels: IntArray, width: Int, height: Int): Long {
        if (pixels.isEmpty() || width <= 0 || height <= 0) return 0L
        var hash = 1125899906842597L
        val stepX = (width / 8).coerceAtLeast(1)
        val stepY = (height / 8).coerceAtLeast(1)
        for (y in 0 until height step stepY) {
            val rowOffset = y * width
            for (x in 0 until width step stepX) {
                val color = pixels[rowOffset + x]
                val lum = ((color shr 16 and 0xFF) * 299 + (color shr 8 and 0xFF) * 587 + (color and 0xFF) * 114) / 1000
                hash = 31L * hash + lum
            }
        }
        return hash
    }

    private fun executeOcrSearchSequence(action: ActionConfig, isTestRun: Boolean = false): Boolean {
        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.R) return false
        val query = action.targetScriptToLoad.ifEmpty { "OK" }
        logAppEvent(this, "OCR_SEARCH", "🔍 Поиск текста на экране: '$query'")
        val screenshotLatch = CountDownLatch(1)
        var isMatched = false

        hideOverlaysAndWait()
        takeScreenshot(Display.DEFAULT_DISPLAY, bgScannerExecutor, object : TakeScreenshotCallback {
            override fun onSuccess(screenshotResult: ScreenshotResult) {
                val hwBuffer = screenshotResult.hardwareBuffer
                try {
                    val hwBitmap = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                        Bitmap.wrapHardwareBuffer(hwBuffer, screenshotResult.colorSpace)
                    } else null
                    val softwareBitmap = hwBitmap?.copy(Bitmap.Config.ARGB_8888, false)
                    if (softwareBitmap != null) {
                        if (action.targetScriptToLoad.contains("=")) {
                            val parts = action.targetScriptToLoad.split("=")
                            val varName = parts.getOrNull(0)?.trim() ?: ""
                            val regexPattern = parts.getOrNull(1)?.trim() ?: "\\d+"
                            val extracted = OcrEngine.findAndExtractRegex(softwareBitmap, regexPattern)
                            if (extracted != null) {
                                runtimeVariables[varName] = extracted
                                logicEngine.setVariable(varName, extracted)
                            }
                        }
                        val matches = OcrEngine.findTextOnScreen(softwareBitmap, query)
                        if (matches.isNotEmpty()) {
                            val best = matches.first()
                            val dm = resources.displayMetrics
                            val clickX = best.clickPoint.x.toFloat().coerceIn(0f, dm.widthPixels - 1f)
                            val clickY = best.clickPoint.y.toFloat().coerceIn(0f, dm.heightPixels - 1f)

                            logAppEvent(this@MyAutoClickService, "OCR_SEARCH", "🎯 Текст '$query' найден в ($clickX, $clickY)")
                            uiExecutor.execute {
                                showClickVisualizer(clickX, clickY)
                                showHighlightBox(best.rect)
                                if (isTestRun) Toast.makeText(this@MyAutoClickService, "Текст '$query' найден!", Toast.LENGTH_SHORT).show()
                            }
                            if (action.clickAiTarget || isTestRun) {
                                performClick(clickX, clickY, globalClickDurationMs)
                                statsHudView?.recordMatch()
                            }
                            isMatched = true
                        } else if (isTestRun) {
                            uiExecutor.execute { Toast.makeText(this@MyAutoClickService, "Текст '$query' не найден", Toast.LENGTH_SHORT).show() }
                        }
                        softwareBitmap.recycle()
                    }
                } catch (e: Exception) {
                    logError(this@MyAutoClickService, e)
                } finally {
                    try { hwBuffer.close() } catch (_: Exception) {}
                    screenshotLatch.countDown()
                }
            }

            override fun onFailure(errorCode: Int) {
                uiExecutor.execute { setOverlaysVisibleForCapture(true) }
                screenshotLatch.countDown()
            }
        })

        try { screenshotLatch.await(3000, TimeUnit.MILLISECONDS) } catch (_: Exception) {}
        return isMatched
    }

    /**
     * Вычисляет логические и математические условия над переменными OCR.
     * Поддерживает выражения вида: "{hp} < 2000", "{gold} >= 500", "{status} == 'READY'".
     * TARGET DEPTH: [D:1]
     */
    fun evaluateLogicCondition(expression: String): Boolean {
        try {
            logAppEvent(this, "LOGIC_EVAL", "🔍 Вычисление логического выражения: '$expression'")
            val exp = expression.trim()
            val operators = listOf("<=", ">=", "!=", "==", "<", ">")
            val op = operators.firstOrNull { exp.contains(it) } ?: return false

            val parts = exp.split(op, limit = 2)
            if (parts.size < 2) return false

            var leftRaw = parts[0].trim().removeSurrounding("{", "}").removeSurrounding("\"", "")
            var rightRaw = parts[1].trim().removeSurrounding("{", "}").removeSurrounding("\"", "")

            // Подстановка значений из хранилища переменных OCR
            val leftVal = runtimeVariables[leftRaw] ?: leftRaw
            val rightVal = runtimeVariables[rightRaw] ?: rightRaw

            val leftNum = leftVal.toDoubleOrNull()
            val rightNum = rightVal.toDoubleOrNull()

            val result = if (leftNum != null && rightNum != null) {
                when (op) {
                    "==" -> abs(leftNum - rightNum) < 1e-6
                    "!=" -> abs(leftNum - rightNum) >= 1e-6
                    "<" -> leftNum < rightNum
                    ">" -> leftNum > rightNum
                    "<=" -> leftNum <= rightNum
                    ">=" -> leftNum >= rightNum
                    else -> false
                }
            } else {
                when (op) {
                    "==" -> leftVal.equals(rightVal, ignoreCase = true)
                    "!=" -> !leftVal.equals(rightVal, ignoreCase = true)
                    else -> false
                }
            }

            logAppEvent(this, "LOGIC_EVAL", "Результат: ($leftVal $op $rightVal) => $result")
            return result
        } catch (e: Exception) {
            logError(this, e)
            return false
        }
    }

    /**
     * Выполняет поиск составных условий ИИ (AND / NOT / ALL).
     * Режимы задаются в targetScriptToLoad: "LOGIC:AND", "LOGIC:NOT", "LOGIC:ALL".
     * TARGET DEPTH: [D:1]
     */
    private fun executeCompositeAiCondition(action: ActionConfig): Boolean {
        val mode = action.targetScriptToLoad.removePrefix("LOGIC:").trim().uppercase(Locale.getDefault())
        logAppEvent(this, "AI_COMPOSITE", "⚙️ Проверка составного условия [$mode] для Шага #${action.id}")

        when (mode) {
            "AND", "ALL" -> {
                // Все шаблоны должны быть найдены
                for (templateIdx in action.multiTemplateIndices) {
                    val singleAction = ActionConfig(action.id, action.startView, action.type).apply {
                        selectedTemplateIndex = templateIdx
                        similarityPercent = action.similarityPercent
                        aiTimeoutSeconds = 1
                    }
                    val found = executeAiTriggerSequence(singleAction, isTestRun = true)
                    if (!found) return false
                }
                return true
            }
            "NOT", "NONE" -> {
                // Ни один из шаблонов не должен быть найден
                return !executeAiTriggerSequence(action, isTestRun = true)
            }
            else -> return executeAiTriggerSequence(action)
        }
    }

    private fun executeAiTriggerSequence(action: ActionConfig, isTestRun: Boolean = false): Boolean {
        val rawIndices = if (action.multiTemplateIndices.isNotEmpty()) {
            action.multiTemplateIndices
        } else if (action.selectedTemplateIndex in globalTemplates.indices) {
            arrayListOf(action.selectedTemplateIndex)
        } else {
            ArrayList(globalTemplates.indices.toList())
        }

        val searchIndices = ArrayList(rawIndices)
        if (searchIndices.isEmpty()) {
            logAppEvent(this, "AI_SEARCH", "Шаг #${action.id}: Список шаблонов пуст, сканирование отменено.")
            return false
        }

        val timeoutSeconds = if (action.aiTimeoutSeconds > 0) action.aiTimeoutSeconds else (if (isTestRun) 3 else 5)
        val timeoutMs = timeoutSeconds * 1000L
        val startTime = System.currentTimeMillis()
        val loopIntervalMs = action.checkInterval.coerceIn(50L, 5000L)
        val baseRequiredScore = (action.similarityPercent.coerceIn(40, 100)) / 100f

        logAppEvent(this, "AI_SEARCH", "▶ Старт поиска для Шага #${action.id}. Шаблонов: ${searchIndices.size}, Порог: ${action.similarityPercent}%, Таймаут: ${timeoutSeconds}с")
        startActionScanningVisual(action)

        var scanIteration = 0
        while ((isPlaying || isTestRun) && (System.currentTimeMillis() - startTime < timeoutMs)) {
            scanIteration++
            val elapsedScan = System.currentTimeMillis() - startTime
            val currentRequiredScore = (baseRequiredScore - (elapsedScan.toFloat() / timeoutMs.toFloat()) * 0.10f).coerceAtLeast(0.40f)
            val screenshotLatch = CountDownLatch(1)
            val winnerRef = java.util.concurrent.atomic.AtomicReference<Pair<MatchCandidate, Int>?>()

            hideOverlaysAndWait()
            takeScreenshot(
                Display.DEFAULT_DISPLAY,
                bgScannerExecutor,
                object : TakeScreenshotCallback {
                    override fun onSuccess(screenshotResult: ScreenshotResult) {
                        uiExecutor.execute { setOverlaysVisibleForCapture(true) }
                        val hwBuffer = screenshotResult.hardwareBuffer
                        try {
                            val hwBitmap = if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                                Bitmap.wrapHardwareBuffer(hwBuffer, screenshotResult.colorSpace)
                            } else null
                            val softwareBitmap = hwBitmap?.copy(Bitmap.Config.ARGB_8888, false)
                            if (softwareBitmap != null) {
                                val sw = softwareBitmap.width
                                val sh = softwareBitmap.height
                                val totalPixels = sw * sh
                                var pool = reusablePixelsPool
                                if (pool == null || pool.size < totalPixels) {
                                    pool = IntArray(totalPixels)
                                    reusablePixelsPool = pool
                                }
                                val sharedPixels = pool
                                softwareBitmap.getPixels(sharedPixels, 0, sw, 0, 0, sw, sh)
                                val tournamentPool = mutableListOf<Pair<MatchCandidate, Int>>()

                                // Адаптивный троттлинг: замер изменения содержимого кадра
                                val currentHash = computeFastScreenHash(sharedPixels, sw, sh)
                                if (currentHash == lastScreenHash) {
                                    staticScreenCount++
                                } else {
                                    if (staticScreenCount >= 3) {
                                        logAppEvent(this@MyAutoClickService, "STABILITY", "⚡ Активность на экране! Возврат к максимальной частоте сканирования.")
                                    }
                                    staticScreenCount = 0
                                    lastScreenHash = currentHash
                                }

                                for (idx in searchIndices) {
                                    if (!isPlaying && !isTestRun) break
                                    if (idx !in globalTemplates.indices) continue

                                    val template = globalTemplates[idx]
                                    val templatePath = globalTemplatesNames.getOrNull(idx) ?: ""
                                    val meta = loadTemplateMetadata(templatePath)

                                    val scopedCacheKey = "${action.id}_${templatePath}"
                                    val dynamicThreshold = (currentRequiredScore * 100).toInt()
                                    val matches = findTemplateFastCascade(
                                        sharedPixels, sw, sh,
                                        template,
                                        meta,
                                        scopedCacheKey,
                                        minSimilarityPercent = dynamicThreshold,
                                        actionOverride = action
                                    )

                                    for (m in matches) {
                                        logAppEvent(this@MyAutoClickService, "AI_SEARCH", "Итерация #$scanIteration | Шаблон #${idx + 1}: Найдено совпадение score=${(m.score * 100).toInt()}% в ${m.rect}")
                                        if (m.score >= currentRequiredScore) {
                                            tournamentPool.add(Pair(m, idx))
                                        }
                                    }
                                }

                                if (tournamentPool.isNotEmpty()) {
                                    tournamentPool.sortByDescending { it.first.score }
                                    val best = tournamentPool.first()
                                    winnerRef.set(best)
                                    logAppEvent(this@MyAutoClickService, "AI_SEARCH", "🏆 Победитель поиска: Шаблон #${best.second + 1} со скором ${(best.first.score * 100).toInt()}%")
                                }

                                softwareBitmap.recycle()
                            }
                        } catch (e: Exception) {
                            logError(this@MyAutoClickService, e)
                        } finally {
                            try { hwBuffer.close() } catch (_: Exception) {}
                            screenshotLatch.countDown()
                        }
                    }

                    override fun onFailure(errorCode: Int) {
                        uiExecutor.execute { setOverlaysVisibleForCapture(true) }
                        logAppEvent(this@MyAutoClickService, "AI_SEARCH", "⚠️ Ошибка захвата скриншота ОС, код: $errorCode")
                        screenshotLatch.countDown()
                    }
                })

            try {
                screenshotLatch.await(3000, java.util.concurrent.TimeUnit.MILLISECONDS)
            } catch (_: Exception) {}
            if (!isPlaying && !isTestRun) break

            val winner = winnerRef.get()
            if (winner != null) {
                val winnerCandidate = winner.first
                val dm = resources.displayMetrics
                val (gOffX, gOffY) = computeGaussianOffset(action.randomRadius)
                val clickX = (winnerCandidate.point.x.toFloat() + gOffX).coerceIn(0f, dm.widthPixels.toFloat() - 1f)
                val clickY = (winnerCandidate.point.y.toFloat() + gOffY).coerceIn(0f, dm.heightPixels.toFloat() - 1f)

                logAppEvent(this, "AI_SEARCH", "🎯 КЛИК ПО ЦЕЛИ: ($clickX, $clickY) для Шага #${action.id}")
                showClickVisualizer(clickX, clickY)
                showHighlightBox(winnerCandidate.rect)

                if (action.clickAiTarget || isTestRun) {
                    performClick(clickX, clickY, globalClickDurationMs)
                    if (isTestRun) uiExecutor.execute { Toast.makeText(this, "ИИ: Найдено (${(winnerCandidate.score * 100).toInt()}%)", Toast.LENGTH_SHORT).show() }
                }

                stopActionScanningVisual()
                return true
            }

            // Адаптивная пауза: если кадр статичен более 2 итераций, снижаем частоту опроса
            val adaptiveInterval = if (staticScreenCount >= 2) {
                (loopIntervalMs * 2.5).toLong().coerceIn(350L, 1000L)
            } else {
                loopIntervalMs
            }

            try {
                Thread.sleep(adaptiveInterval)
            } catch (_: InterruptedException) {
                break
            }
        }

        logAppEvent(this, "AI_SEARCH", "⏹ Завершение поиска для Шага #${action.id}")
        stopActionScanningVisual()
        if (isTestRun) uiExecutor.execute { Toast.makeText(this, "ИИ: Объект не найден", Toast.LENGTH_SHORT).show() }
        return false
    }

    /**
     * Ожидает ИСЧЕЗНОВЕНИЯ шаблона с экрана (экраны загрузки, спиннеры, диалоги).
     * TARGET DEPTH: [D:1]
     */
    private fun executeWaitUntilDisappearSequence(action: ActionConfig, timeoutSeconds: Int = 30): Boolean {
        logAppEvent(this, "AI_WAIT_DISAPPEAR", "⏳ Ожидание исчезновения объекта для Шага #${action.id} (Таймаут: ${timeoutSeconds}с)")
        val startTime = System.currentTimeMillis()
        val timeoutMs = timeoutSeconds * 1000L
        val intervalMs = action.checkInterval.coerceIn(100L, 2000L)

        while (isPlaying && (System.currentTimeMillis() - startTime < timeoutMs)) {
            val isStillPresent = executeAiTriggerSequence(action, isTestRun = true)
            if (!isStillPresent) {
                logAppEvent(this, "AI_WAIT_DISAPPEAR", "✅ Объект исчез с экрана. Переход к следующему действию.")
                return true
            }
            try {
                Thread.sleep(intervalMs)
            } catch (_: InterruptedException) {
                break
            }
        }
        logAppEvent(this, "AI_WAIT_DISAPPEAR", "⚠️ Таймаут: Объект не исчез за ${timeoutSeconds}с.")
        return false
    }

    private var highlightBoxView: View? = null

    private fun showHighlightBox(rect: Rect) {
        uiExecutor.execute {
            if (highlightBoxView != null) {
                safeRemoveView(highlightBoxView)
                highlightBoxView = null
            }

            highlightBoxView = View(this).apply {
                background = android.graphics.drawable.GradientDrawable().apply {
                    setStroke(dpToPx(2.5f), Color.parseColor("#00F5D4"))
                    setColor(Color.parseColor("#2500F5D4"))
                    cornerRadius = dpToPx(6).toFloat()
                }
                scaleX = 1.15f
                scaleY = 1.15f
                alpha = 0f
            }

            val params = WindowManager.LayoutParams(
                rect.width(),
                rect.height(),
                getOverlayType(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                PixelFormat.TRANSLUCENT
            ).apply {
                gravity = Gravity.TOP or Gravity.START
                x = rect.left
                y = rect.top
            }

            safeAddView(highlightBoxView, params)

            highlightBoxView?.animate()
                ?.scaleX(1.0f)
                ?.scaleY(1.0f)
                ?.alpha(1.0f)
                ?.setDuration(180)
                ?.setInterpolator(android.view.animation.DecelerateInterpolator())
                ?.withEndAction {
                    Handler(Looper.getMainLooper()).postDelayed({
                        highlightBoxView?.animate()?.alpha(0f)?.setDuration(250)?.withEndAction {
                            safeRemoveView(highlightBoxView)
                            highlightBoxView = null
                        }?.start()
                    }, 1400L)
                }
                ?.start()
        }
    }

    private fun getDeviceSpecsJson(): JSONObject {
        val dm = resources.displayMetrics
        val isLandscape = dm.widthPixels > dm.heightPixels
        return JSONObject().apply {
            put("screenWidth", dm.widthPixels)
            put("screenHeight", dm.heightPixels)
            put("densityDpi", dm.densityDpi)
            put("density", dm.density.toDouble())
            put("isLandscape", isLandscape)
        }
    }

    fun saveTemplateMetadata(
        maskPath: String,
        similarityPct: Int,
        isPinned: Boolean = true,
        localArea: Boolean = false,
        customArea: Boolean = false,
        sX: Int = 0,
        sY: Int = 0,
        sW: Int = 0,
        sH: Int = 0,
        mX: Int = 0,
        mY: Int = 0,
        mW: Int = 0,
        mH: Int = 0
    ) {
        try {
            if (maskPath.isEmpty()) return
            val metaFile = getTemplateMetadataFile(maskPath)
            val json = if (metaFile.exists()) JSONObject(metaFile.readText()) else JSONObject()

            json.put("similarityPercent", similarityPct)
            json.put("isPinned", isPinned)
            json.put("sourceDevice", getDeviceSpecsJson())
            json.put("searchInCapturedArea", localArea)
            json.put("customSearchArea", customArea)
            json.put("searchAreaX", sX)
            json.put("searchAreaY", sY)
            json.put("searchAreaW", sW)
            json.put("searchAreaH", sH)
            if (mW > 0) {
                json.put("originX", mX)
                json.put("originY", mY)
                json.put("originW", mW)
                json.put("originH", mH)
            }
            FileOutputStream(metaFile).use { out -> out.write(json.toString().toByteArray()) }
        } catch (e: Exception) {
            logError(this, e)
        }
    }

    private fun findCandidatesForCreation(
        screenBitmap: Bitmap,
        template: Bitmap,
        cropX: Int,
        cropY: Int,
        cropW: Int,
        cropH: Int
    ): MutableList<MatchCandidate> {
        val candidates = mutableListOf<MatchCandidate>()

        val safeX = cropX.coerceIn(0, (screenBitmap.width - 1).coerceAtLeast(0))
        val safeY = cropY.coerceIn(0, (screenBitmap.height - 1).coerceAtLeast(0))
        val safeW = cropW.coerceIn(1, screenBitmap.width - safeX)
        val safeH = cropH.coerceIn(1, screenBitmap.height - safeY)

        val originRect = Rect(safeX, safeY, safeX + safeW, safeY + safeH)
        val originPoint = Point(safeX + safeW / 2, safeY + safeH / 2)
        val originCandidate = MatchCandidate(originPoint, originRect, 1.0f)
        candidates.add(originCandidate)

        val pixels = IntArray(screenBitmap.width * screenBitmap.height)
        screenBitmap.getPixels(pixels, 0, screenBitmap.width, 0, 0, screenBitmap.width, screenBitmap.height)
        val candidatesFromSearch = findTemplateFastCascade(pixels, screenBitmap.width, screenBitmap.height, template, null)
        for (cand in candidatesFromSearch) {
            if (!Rect.intersects(cand.rect, originRect) && candidates.size < 6) {
                candidates.add(cand)
            }
        }

        return candidates
    }

