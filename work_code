            getOverlayType(),
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
            PixelFormat.TRANSLUCENT
        ).apply {
            if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                layoutInDisplayCutoutMode = WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
            }
            gravity = Gravity.TOP or Gravity.START
            x = dpToPx(200)
            y = screenH / 2 - targetSize / 2
        }

        joystickTargetView = FrameLayout(this).apply {
            val circle = View(context).apply {
                background = android.graphics.drawable.GradientDrawable().apply {
                    shape = android.graphics.drawable.GradientDrawable.OVAL
                    setColor(Color.parseColor("#40FFB703"))
                    setStroke(dpToPx(2.5f), Color.parseColor("#FFB703"))
                }
            }
            addView(circle, FrameLayout.LayoutParams(targetSize, targetSize))
            val icon = TextView(context).apply {
                text = "✥"
                setTextColor(Color.parseColor("#FFB703"))
                textSize = 18f
                gravity = Gravity.CENTER
            }
            addView(icon, FrameLayout.LayoutParams(targetSize, targetSize))

            setOnTouchListener(object : View.OnTouchListener {
                var initX = 0; var initY = 0
                var touchX = 0f; var touchY = 0f
                override fun onTouch(v: View, event: MotionEvent): Boolean {
                    when (event.action) {
                        MotionEvent.ACTION_DOWN -> {
                            initX = targetParams.x; initY = targetParams.y
                            touchX = event.rawX; touchY = event.rawY
                            return true
                        }
                        MotionEvent.ACTION_MOVE -> {
                            targetParams.x = (initX + (event.rawX - touchX).toInt()).coerceIn(0, screenW - targetSize)
                            targetParams.y = (initY + (event.rawY - touchY).toInt()).coerceIn(0, screenH - targetSize)
                            safeUpdateViewLayout(joystickTargetView, targetParams)
                            return true
                        }
                    }
                    return false
                }
            })
        }

        val handleMove = findViewByName<TextView>(joystickOverlayView!!, "handleMoveJoystick")
        val btnClose = findViewByName<ImageButton>(joystickOverlayView!!, "btnCloseJoystick")
        val btnRecordJoystick = findViewByName<Button>(joystickOverlayView!!, "btnRecordJoystick")
        val viewKnob = findViewByName<View>(joystickOverlayView!!, "viewJoystickKnob")

        var isJoystickRecording = false
        var currentSessionDuration = 0L
        val sessionPathPoints = arrayListOf<android.graphics.PointF>()
        var strokeStartTime = 0L
        var isWaitingForJoystickTouch = false
        var liveKnobX = 0f
        var liveKnobY = 0f

        val dragFrameListener = object : View.OnTouchListener {
            private var initX = 0; private var initY = 0
            private var touchX = 0f; private var touchY = 0f
            override fun onTouch(v: View, event: MotionEvent): Boolean {
                when (event.action) {
                    MotionEvent.ACTION_DOWN -> {
                        initX = params.x; initY = params.y
                        touchX = event.rawX; touchY = event.rawY
                        return true
                    }
                    MotionEvent.ACTION_MOVE -> {
                        params.x = (initX + (event.rawX - touchX).toInt()).coerceIn(0, screenW - sizePx)
                        params.y = (initY + (event.rawY - touchY).toInt()).coerceIn(0, screenH - sizePx)
                        safeUpdateViewLayout(joystickOverlayView, params)
                        return true
                    }
                }
                return false
            }
        }
        handleMove?.setOnTouchListener(dragFrameListener)

        viewKnob?.setOnTouchListener(object : View.OnTouchListener {
            private val maxRadiusPx = dpToPx(48).toFloat()
            private var baseCenterX = 0f
            private var baseCenterY = 0f

            override fun onTouch(v: View, event: MotionEvent): Boolean {
                val targetCenterX = (targetParams.x + targetSize / 2f).coerceIn(0f, screenW.toFloat() - 1f)
                val targetCenterY = (targetParams.y + targetSize / 2f).coerceIn(0f, screenH.toFloat() - 1f)

                when (event.action) {
                    MotionEvent.ACTION_DOWN -> {
                        val knobLoc = IntArray(2)
                        v.getLocationOnScreen(knobLoc)
                        baseCenterX = knobLoc[0] + v.width / 2f - v.translationX
                        baseCenterY = knobLoc[1] + v.height / 2f - v.translationY

                        targetParams.flags = targetParams.flags or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE
                        safeUpdateViewLayout(joystickTargetView, targetParams)

                        if (isWaitingForJoystickTouch) {
                            isWaitingForJoystickTouch = false
                            isJoystickRecording = true
                            btnRecordJoystick?.text = "🔴 ЗАПИСЬ..."
                            btnRecordJoystick?.backgroundTintList = ColorStateList.valueOf(Color.parseColor("#F04438"))
                            sessionPathPoints.clear()
                            currentSessionDuration = 0L
                        }

                        strokeStartTime = System.currentTimeMillis()
                        isLiveJoystickActive = true
                        liveKnobX = 0f
                        liveKnobY = 0f
                        lastInjectX = targetCenterX
                        lastInjectY = targetCenterY
                        activeJoystickStroke = null

                        if (isJoystickRecording) {
                            sessionPathPoints.add(android.graphics.PointF(targetCenterX, targetCenterY))
                        }

                        liveJoystickRunnable = object : Runnable {
                            private var toggleJitter = false
                            override fun run() {
                                if (!isLiveJoystickActive) return
                                val curX = (targetCenterX + liveKnobX).coerceIn(0f, screenW.toFloat() - 1f)
                                val curY = (targetCenterY + liveKnobY).coerceIn(0f, screenH.toFloat() - 1f)

                                // Защита от 0-length path (микро-сдвиг 0.05px для стабильности продолжения жеста)
                                toggleJitter = !toggleJitter
                                val jitter = if (toggleJitter) 0.05f else -0.05f

                                val path = Path().apply {
                                    moveTo(lastInjectX, lastInjectY)
                                    lineTo(curX + jitter, curY + jitter)
                                }
                                val newStroke = if (activeJoystickStroke == null) {
                                    GestureDescription.StrokeDescription(path, 0L, 45L, true)
                                } else {
                                    activeJoystickStroke!!.continueStroke(path, 0L, 45L, true)
                                }
                                activeJoystickStroke = newStroke
                                lastInjectX = curX + jitter
                                lastInjectY = curY + jitter
                                dispatchGesture(GestureDescription.Builder().addStroke(newStroke).build(), null, null)
                                liveJoystickHandler.postDelayed(this, 40L)
                            }
                        }
                        liveJoystickHandler.post(liveJoystickRunnable!!)
                        return true
                    }

                    MotionEvent.ACTION_MOVE -> {
                        val dx = event.rawX - baseCenterX
                        val dy = event.rawY - baseCenterY
                        val dist = hypot(dx.toDouble(), dy.toDouble()).toFloat()
                        val angle = atan2(dy.toDouble(), dx.toDouble())
                        val clampedDist = min(dist, maxRadiusPx)

                        val knobX = (clampedDist * cos(angle)).toFloat()
                        val knobY = (clampedDist * sin(angle)).toFloat()

                        viewKnob.translationX = knobX
                        viewKnob.translationY = knobY
                        liveKnobX = knobX
                        liveKnobY = knobY

                        val injectX = (targetCenterX + knobX).coerceIn(0f, screenW.toFloat() - 1f)
                        val injectY = (targetCenterY + knobY).coerceIn(0f, screenH.toFloat() - 1f)

                        if (isJoystickRecording) {
                            val lastP = sessionPathPoints.lastOrNull()
                            if (lastP == null || hypot((injectX - lastP.x).toDouble(), (injectY - lastP.y).toDouble()) > 4.0) {
                                sessionPathPoints.add(android.graphics.PointF(injectX, injectY))
                            }
                        }
                        return true
                    }

                    MotionEvent.ACTION_UP, MotionEvent.ACTION_CANCEL -> {
                        v.performClick()
                        emergencyReleaseActiveJoystickStroke()
                        viewKnob.animate().translationX(0f).translationY(0f).setDuration(100).start()

                        targetParams.flags = targetParams.flags and WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE.inv()
                        safeUpdateViewLayout(joystickTargetView, targetParams)

                        val duration = (System.currentTimeMillis() - strokeStartTime).coerceAtLeast(10L)
                        if (isJoystickRecording) {
                            currentSessionDuration += duration
                            sessionPathPoints.add(android.graphics.PointF(targetCenterX, targetCenterY))
                            isJoystickRecording = false
                            btnRecordJoystick?.text = "⏺ ЗАПИСАТЬ"
                            btnRecordJoystick?.backgroundTintList = ColorStateList.valueOf(Color.parseColor("#58A6FF"))

                            if (sessionPathPoints.size >= 2) {
                                addNewActionAtPosition(targetCenterX, targetCenterY, 300L, ActionType.PATH, -1)
                                val cfg = actionsList.last()
                                cfg.holdDuration = currentSessionDuration.coerceAtLeast(100L)
                                cfg.pathPoints = ArrayList(sessionPathPoints)
                                Toast.makeText(this@MyAutoClickService, "✅ Векторный путь сохранен!", Toast.LENGTH_SHORT).show()
                                dismissJoystick()
                            }
                        }
                        return true
                    }
                }
                return false
            }
        })

        btnRecordJoystick?.setOnClickListener {
            vibrateFeedback(25L)
            if (!isWaitingForJoystickTouch && !isJoystickRecording) {
                isWaitingForJoystickTouch = true
                btnRecordJoystick.text = "⏳ КОСНИТЕСЬ ДЖОЙСТИКА"
                btnRecordJoystick.backgroundTintList = ColorStateList.valueOf(Color.parseColor("#FFB703"))
            } else {
                btnRecordJoystick.text = "⏺ ЗАПИСАТЬ"
                btnRecordJoystick.backgroundTintList = ColorStateList.valueOf(Color.parseColor("#58A6FF"))
                isWaitingForJoystickTouch = false
                isJoystickRecording = false
            }
        }

        btnClose?.setOnClickListener {
            vibrateFeedback(25L)
            dismissJoystick()
        }

        safeAddView(joystickOverlayView, params)
        safeAddView(joystickTargetView, targetParams)
    }

