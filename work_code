            // renderCandidatesRef объявлена в начале метода

            executeSelectionConfirmRef = { selectedCand, trimmedMaskToSave ->
                vibrateFeedback(35L)
                safeRemoveView(overlayView)
                activeCalibrationOverlayView = null
                setOverlaysVisibleForCapture(true)
                pendingRecomputeRunnable?.let { recomputeHandler.removeCallbacks(it) }

                bgScannerExecutor.execute {
                    try {
                        val ts = System.currentTimeMillis()
                        val targetDir = File(filesDir, "templates/default").apply { mkdirs() }
                        val tPath =
                            existingTemplatePath ?: File(targetDir, "mask_$ts.png").absolutePath
                        val fPath = existingTemplatePath?.replace("mask_", "full_") ?: File(
                            targetDir,
                            "full_$ts.png"
                        ).absolutePath

                        saveBitmapToPng(trimmedMaskToSave, File(tPath))
                        if (existingConfig == null && !screenshot.isRecycled) {
                            saveBitmapToPng(screenshot, File(fPath))
                        }

                        val metaFile = getTemplateMetadataFile(tPath)
                        val meta =
                            if (metaFile.exists()) JSONObject(metaFile.readText()) else JSONObject()
                        meta.put("similarityPercent", currentSimilarity)
                        meta.put("bgTolerance", currentBgTolerance)
                        meta.put("sourceDevice", getDeviceSpecsJson())
                        meta.put("scanStepPreset", currentScanStep)
                        meta.put("isContourMode", currentIsContourMode)
                        meta.put("isAnimMode", currentIsAnimMode)
                        meta.put("isSubpixelMode", currentIsSubpixelMode)
                        meta.put("originX", selectedCand.rect.left)
                        meta.put("originY", selectedCand.rect.top)
                        meta.put("originW", selectedCand.rect.width())
                        meta.put("originH", selectedCand.rect.height())
                        meta.put("isCircleShape", currentShapeMode == 0)

                        val smartData = analyzeTemplate(trimmedMaskToSave)
                        for (key in smartData.keys()) {
                            val k = key.toString()
                            meta.put(k, smartData.get(k))
                        }
                        FileOutputStream(metaFile).use { out ->
                            out.write(
                                meta.toString().toByteArray()
                            )
                        }

                        uiExecutor.execute {
                            loadAllTemplatesFromDisk()
                            val newIndex = globalTemplatesNames.indexOf(tPath)

                            if (existingConfig == null) {
                                val offsetMarkerX = (selectedCand.rect.right + dpToPx(12)).coerceIn(
                                    0,
                                    screenW - dpToPx(40)
                                ).toFloat()
                                val offsetMarkerY = (selectedCand.rect.top - dpToPx(12)).coerceIn(
                                    dpToPx(40),
                                    screenH - dpToPx(40)
                                ).toFloat()
                                addNewActionAtPosition(
                                    offsetMarkerX,
                                    offsetMarkerY,
                                    1000L,
                                    ActionType.TRIGGER,
                                    newIndex
                                )
                                val newAction = actionsList.last()
                                newAction.type = ActionType.TRIGGER
                                newAction.clickAiTarget = true
                                newAction.selectedTemplateIndex = newIndex
                                newAction.similarityPercent = currentSimilarity
                                newAction.isContourMode = currentIsContourMode
                                newAction.isAnimMode = currentIsAnimMode
                                newAction.isSubpixelMode = currentIsSubpixelMode
                                newAction.scanStepPreset = currentScanStep
                                newAction.aiTimeoutSeconds = 5
                                newAction.multiTemplateIndices =
                                    if (newIndex != -1) arrayListOf(newIndex) else arrayListOf()

                                Toast.makeText(
                                    this@MyAutoClickService,
                                    "Шаблон сохранен для нового шага",
                                    Toast.LENGTH_SHORT
                                ).show()
                                restoreControlPanelImmediately()
                            } else {
                                existingConfig.type = ActionType.TRIGGER
                                existingConfig.clickAiTarget = true
                                existingConfig.selectedTemplateIndex = newIndex
                                existingConfig.similarityPercent = currentSimilarity
                                existingConfig.isContourMode = currentIsContourMode
                                existingConfig.isAnimMode = currentIsAnimMode
                                existingConfig.isSubpixelMode = currentIsSubpixelMode
                                existingConfig.scanStepPreset = currentScanStep
                                if (existingConfig.aiTimeoutSeconds <= 2) existingConfig.aiTimeoutSeconds =
                                    5
                                if (newIndex != -1 && !existingConfig.multiTemplateIndices.contains(
                                        newIndex
                                    )
                                ) {
                                    existingConfig.multiTemplateIndices.add(newIndex)
                                }
                                if (existingConfig.multiTemplateIndices.isEmpty() && newIndex != -1) {
                                    existingConfig.multiTemplateIndices.add(newIndex)
                                }

                                val targetLp =
                                    existingConfig.startView.layoutParams as? WindowManager.LayoutParams
                                if (targetLp != null) {
                                    val sizePx =
                                        if (existingConfig.startView.width > 0) existingConfig.startView.width else dpToPx(
                                            36
                                        )
                                    targetLp.x = (selectedCand.point.x - sizePx / 2f).toInt()
                                    targetLp.y = (selectedCand.point.y - sizePx / 2f).toInt()
                                    safeUpdateViewLayout(existingConfig.startView, targetLp)
                                }

                                Toast.makeText(
                                    this@MyAutoClickService,
                                    "Шаг переключен на ИИ и синхронизирован",
                                    Toast.LENGTH_SHORT
                                ).show()
                                restoreControlPanelImmediately()
                                showEditDialog(existingConfig)
                            }
                        }
                    } catch (e: Exception) {
                        logError(this@MyAutoClickService, e)
                        restoreControlPanelImmediately()
                    } finally {
                        uiExecutor.execute {
                            currentTrimmedMask?.let {
                                if (it != rawTemplateBitmap) it.recycle()
                            }
                            if (!screenshot.isRecycled) screenshot.recycle()
                            if (existingConfig == null && !rawTemplateBitmap.isRecycled) rawTemplateBitmap.recycle()
                        }
                    }
                }
            }

            renderCandidatesRef = {
                candidatesContainer.removeAllViews()
                logAppEvent(
                    this,
                    "CALIBRATION",
                    "[renderCandidatesRef] Отрисовка кандидатов: ${currentCandidates.size}"
                )

                if (!screenshot.isRecycled && !rawTemplateBitmap.isRecycled) {
                    val trimmedMaskBitmap = currentTrimmedMask ?: run {
                        val currentMask = generateSmartMask(
                            rawTemplateBitmap,
                            currentShapeMode == 0,
                            currentBgTolerance,
                            currentShapeMode == 2
                        )
                        val refined = refineAndTrimSmartMask(currentMask, 0, 0)
                        refined.trimmedBitmap.also { currentTrimmedMask = it }
                    }

                    ivLiveMaskPreview?.setImageBitmap(trimmedMaskBitmap)
                    val cutPercent =
                        ((1f - (trimmedMaskBitmap.width * trimmedMaskBitmap.height).toFloat() / (rawTemplateBitmap.width * rawTemplateBitmap.height).toFloat()
                            .coerceAtLeast(1f)) * 100f).toInt().coerceIn(0, 95)
                    tvMaskInfo?.text =
                        "Размер: ${trimmedMaskBitmap.width}x${trimmedMaskBitmap.height} px (Срез: $cutPercent%)\n✨ Волшебная палочка применена"

                    val displayList = if (currentCandidates.isNotEmpty()) currentCandidates else {
                        val defaultW = trimmedMaskBitmap.width.coerceAtLeast(16)
                        val defaultH = trimmedMaskBitmap.height.coerceAtLeast(16)
                        listOf(
                            MatchCandidate(
                                Point(
                                    candOriginX + defaultW / 2,
                                    candOriginY + defaultH / 2
                                ),
                                Rect(
                                    candOriginX,
                                    candOriginY,
                                    candOriginX + defaultW,
                                    candOriginY + defaultH
                                ),
                                1.0f
                            )
                        )
                    }

                    for ((idx, cand) in displayList.withIndex()) {
                        val isSelected = (idx == selectedCandidateIndex)
                        val pct = (cand.score * 100).toInt().coerceIn(0, 100)
                        val colorHex = when {
                            pct >= 85 -> "#00F5D4"
                            pct >= 70 -> "#FFB703"
                            pct >= 50 -> "#58A6FF"
                            else -> "#F04438"
                        }

                        val candW = cand.rect.width().coerceAtLeast(dpToPx(18))
                        val candH = cand.rect.height().coerceAtLeast(dpToPx(18))
                        val isRectShape =
                            (currentShapeMode != 0) || (candW > candH * 1.25f) || (candH > candW * 1.25f)

                        val candView = FrameLayout(this@MyAutoClickService).apply {
                            clipChildren = false
                            clipToPadding = false

                            val bgHighlight = View(context).apply {
                                background = android.graphics.drawable.GradientDrawable().apply {
                                    shape =
                                        if (isRectShape) android.graphics.drawable.GradientDrawable.RECTANGLE else android.graphics.drawable.GradientDrawable.OVAL
                                    if (isRectShape) cornerRadius = dpToPx(6).toFloat()
                                    val alphaColor = if (isSelected) "#3500F5D4" else "#00000000"
                                    val actualStrokeColor = if (isSelected) colorHex else "#555555"
                                    setColor(Color.parseColor(alphaColor))
                                    setStroke(if (isSelected) dpToPx(3f) else dpToPx(1.5f), Color.parseColor(actualStrokeColor))
                                }
                            }
                            addView(
                                bgHighlight,
                                FrameLayout.LayoutParams(
                                    FrameLayout.LayoutParams.MATCH_PARENT,
                                    FrameLayout.LayoutParams.MATCH_PARENT
                                )
                            )

                            val previewView = ImageView(context).apply {
                                setImageBitmap(trimmedMaskBitmap)
                                scaleType = ImageView.ScaleType.FIT_CENTER
                                alpha = 0.85f
                                colorFilter = android.graphics.LightingColorFilter(
                                    Color.parseColor("#00F5D4"),
                                    Color.parseColor("#002B24")
                                )
                            }
                            addView(
                                previewView,
                                FrameLayout.LayoutParams(
                                    FrameLayout.LayoutParams.MATCH_PARENT,
                                    FrameLayout.LayoutParams.MATCH_PARENT
                                )
                            )

                            // Убрано setOnClickListener, чтобы избежать случайного подтверждения при свайпах ползунка
                        }

                        val candParams = FrameLayout.LayoutParams(candW, candH).apply {
                            gravity = Gravity.TOP or Gravity.START
                            leftMargin = cand.rect.left.coerceIn(0, screenW - candW)
                            topMargin = cand.rect.top.coerceIn(0, screenH - candH)
                        }
                        candidatesContainer.addView(candView, candParams)

                        val tvScoreBadge = TextView(this@MyAutoClickService).apply {
                            text = if (isSelected) "✅ #$idx ($pct%)" else "🎯 #$idx ($pct%)"
                            setTextColor(Color.parseColor(if (isSelected) colorHex else "#8B949E"))
                            textSize = if (isSelected) 10f else 9f
                            setTypeface(null, Typeface.BOLD)
                            val padX = dpToPx(6)
                            val padY = dpToPx(2)
                            setPadding(padX, padY, padX, padY)
                            background = android.graphics.drawable.GradientDrawable().apply {
                                setColor(Color.parseColor(if (isSelected) "#EE0D1117" else "#EE161B22"))
                                cornerRadius = dpToPx(5).toFloat()
                                setStroke(if (isSelected) dpToPx(2f) else dpToPx(1f), Color.parseColor(if (isSelected) colorHex else "#555555"))
                            }
                            gravity = Gravity.CENTER
                            isClickable = true
                            setOnClickListener {
                                vibrateFeedback(20L)
                                selectedCandidateIndex = idx
                                renderCandidatesRef()
                            }
                            elevation = if (isSelected) dpToPx(10).toFloat() else 0f
                        }

                        val badgeParams = FrameLayout.LayoutParams(
                            FrameLayout.LayoutParams.WRAP_CONTENT,
                            FrameLayout.LayoutParams.WRAP_CONTENT
                        ).apply {
                            gravity = Gravity.TOP or Gravity.START
                            leftMargin = (cand.rect.left + (candW - dpToPx(60)) / 2).coerceIn(
                                dpToPx(6),
                                screenW - dpToPx(80)
                            )
                            topMargin = (cand.rect.top - dpToPx(24)).coerceIn(
                                dpToPx(30),
                                screenH - dpToPx(40)
                            )
                        }
                        candidatesContainer.addView(tvScoreBadge, badgeParams)
                    }
                }
            }

            triggerRealtimeRecomputeRef = {
                pendingRecomputeRunnable?.let { recomputeHandler.removeCallbacks(it) }
                val task = Runnable {
                    bgScannerExecutor.execute {
                        if (!screenshot.isRecycled && !rawTemplateBitmap.isRecycled) {
                            val dynamicMask =
                                generateSmartMask(rawTemplateBitmap, false, currentBgTolerance)
                            val refined = refineAndTrimSmartMask(dynamicMask, 0, 0)
                            val newTrimmedMask = refined.trimmedBitmap

                            val metaObj = JSONObject().apply {
                                put("similarityPercent", 45)
                                put("isContourMode", currentIsContourMode)
                                put("isAnimMode", currentIsAnimMode)
                                put("isSubpixelMode", currentIsSubpixelMode)
                            }

                            val originCandidate = MatchCandidate(
                                Point(
                                    candOriginX + refined.tightW / 2,
                                    candOriginY + refined.tightH / 2
                                ),
                                Rect(
                                    candOriginX,
                                    candOriginY,
                                    candOriginX + refined.tightW,
                                    candOriginY + refined.tightH
                                ),
                                1.0f
                            )
                            val sw = screenshot.width
                            val sh = screenshot.height
                            val sPx = IntArray(sw * sh)
                            screenshot.getPixels(sPx, 0, sw, 0, 0, sw, sh)
                            val dynamicMatches = findTemplateFastCascade(
                                sPx, sw, sh,
                                newTrimmedMask,
                                metaObj,
                                existingTemplatePath ?: "",
                                minSimilarityPercent = 45
                            )

                            val allCands = mutableListOf<MatchCandidate>()
                            allCands.add(originCandidate)

                            var signalScoreSum = 1.0f
                            var signalCount = 1
                            var maxNoiseScore = 0.0f

                            for (m in dynamicMatches) {
                                if (!Rect.intersects(m.rect, originCandidate.rect)) {
                                    allCands.add(m)
                                    if (m.score >= 0.70f) {
                                        signalScoreSum += m.score
                                        signalCount++
                                    } else if (m.score > maxNoiseScore) {
                                        maxNoiseScore = m.score
                                    }
                                }
                            }

                            val avgSignal = (signalScoreSum / signalCount)
                            val calculatedOptimalThreshold =
                                (((avgSignal + maxNoiseScore) / 2f + 0.05f) * 100).toInt()
                                    .coerceIn(55, 88)

                            val area = refined.tightW * refined.tightH
                            currentScanStep = when {
                                currentIsSubpixelMode || area <= 600 -> 1
                                (avgSignal - maxNoiseScore) >= 0.35f -> 4
                                else -> 2
                            }

                            uiExecutor.execute {
                                updateTrimmedMask(newTrimmedMask)
                                currentCandidates = allCands
                                selectedCandidateIndex = 0
                                currentSimilarity = calculatedOptimalThreshold
                                tvAutoStatus.text =
                                    "✨ ИДЕАЛЬНО! Порог: $currentSimilarity% | Шум: ${(maxNoiseScore * 100).toInt()}%"
                                renderCandidatesRef()
                            }
                        }
                    }
                }
                pendingRecomputeRunnable = task
                recomputeHandler.postDelayed(task, 80L)
            }

            renderCandidatesRef()

            val settingsParams =
                FrameLayout.LayoutParams(cardWidthPx, FrameLayout.LayoutParams.WRAP_CONTENT).apply {
                    gravity = Gravity.TOP or Gravity.START
                }
            overlayView.addView(settingsCard, settingsParams)

            val params = WindowManager.LayoutParams(
                WindowManager.LayoutParams.MATCH_PARENT,
                WindowManager.LayoutParams.MATCH_PARENT,
                getOverlayType(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                PixelFormat.TRANSLUCENT
            ).apply {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                    layoutInDisplayCutoutMode =
                        WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
                }
            }

            activeCalibrationOverlayView = overlayView
            safeAddView(overlayView, params)
        }

        private fun startTemplateCalibration(config: ActionConfig) {
            if (config.selectedTemplateIndex !in globalTemplates.indices) {
                logAppEvent(
                    this,
                    "CALIBRATION",
                    "Ошибка: selectedTemplateIndex (${config.selectedTemplateIndex}) вне диапазона globalTemplates (${globalTemplates.size})"
                )
                return
            }
            isCalibrationCancelled = false
            logAppEvent(
                this,
                "CALIBRATION",
                "Запуск калибровки для шаблона #${config.selectedTemplateIndex + 1}"
            )

            hideControlPanelTemporarily(30000L)
            setOverlaysVisibleForCapture(false)

            val laserContainer = FrameLayout(this@MyAutoClickService).apply {
                clipChildren = false
                clipToPadding = false
            }
            val laserLine = View(this@MyAutoClickService).apply {
                background = android.graphics.drawable.GradientDrawable().apply {
                    setColor(Color.parseColor("#00F5D4"))
                }
                elevation = dpToPx(12).toFloat()
            }
            laserContainer.addView(
                laserLine,
                FrameLayout.LayoutParams(FrameLayout.LayoutParams.MATCH_PARENT, dpToPx(4)).apply {
                    gravity = Gravity.TOP or Gravity.START
                    topMargin = 0
                })

            val hudParams = WindowManager.LayoutParams(
                WindowManager.LayoutParams.MATCH_PARENT, WindowManager.LayoutParams.MATCH_PARENT,
                getOverlayType(),
                WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE or WindowManager.LayoutParams.FLAG_NOT_TOUCHABLE or WindowManager.LayoutParams.FLAG_LAYOUT_IN_SCREEN or WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS,
                PixelFormat.TRANSLUCENT
            ).apply {
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
                    layoutInDisplayCutoutMode =
                        WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
                }
            }

            Handler(Looper.getMainLooper()).postDelayed({
                if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
                    takeScreenshot(
                        Display.DEFAULT_DISPLAY,
                        bgScannerExecutor,
                        object : TakeScreenshotCallback {
                            override fun onSuccess(screenshotResult: ScreenshotResult) {
                                val hwBuffer = screenshotResult.hardwareBuffer
                                try {
                                    logAppEvent(
                                        this@MyAutoClickService,
                                        "CALIBRATION",
                                        "Скриншот успешно захвачен. Запуск HUD..."
                                    )
                                    val hwBitmap =
                                        if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.Q) {
                                            Bitmap.wrapHardwareBuffer(
                                                hwBuffer,
                                                screenshotResult.colorSpace
                                            )
                                        } else null
                                    val softwareBitmap =
                                        hwBitmap?.copy(Bitmap.Config.ARGB_8888, false)
                                    if (softwareBitmap != null) {
                                        uiExecutor.execute {
                                            safeAddView(laserContainer, hudParams)
                                            laserLine.animate()
                                                .translationY(resources.displayMetrics.heightPixels.toFloat())
                                                .setDuration(420)
                                                .setInterpolator(android.view.animation.AccelerateDecelerateInterpolator())
                                                .withEndAction {
                                                    safeRemoveView(laserContainer)
                                                    bgScannerExecutor.execute {
                                                        runSmartCalibration(softwareBitmap, config)
                                                    }
                                                }
                                                .start()
                                        }
                                    } else {
                                        logAppEvent(
                                            this@MyAutoClickService,
                                            "ERROR",
                                            "softwareBitmap == null"
                                        )
                                        uiExecutor.execute { restoreControlPanelImmediately() }
                                    }
                                } catch (e: Exception) {
                                    logError(this@MyAutoClickService, e)
                                    uiExecutor.execute { restoreControlPanelImmediately() }
                                } finally {
                                    try {
                                        hwBuffer.close()
                                    } catch (_: Exception) {
                                    }
                                }
                            }

                            override fun onFailure(errorCode: Int) {
                                setOverlaysVisibleForCapture(true)
                                logAppEvent(
                                    this@MyAutoClickService,
                                    "ERROR",
                                    "takeScreenshot onFailure. Код: $errorCode"
                                )
                                uiExecutor.execute { restoreControlPanelImmediately() }
                            }
                        }
                    )
                }
            }, 300L)
        }

        private fun runSmartCalibration(
            bitmap: Bitmap,
            config: ActionConfig
        ) {
            val template = globalTemplates[config.selectedTemplateIndex]
            val templatePath = globalTemplatesNames[config.selectedTemplateIndex]
            val meta = loadTemplateMetadata(templatePath)
            val isCircle = meta?.optBoolean("isCircleShape", true) ?: true

            logAppEvent(this, "CALIBRATION", "Поиск совпадений на экране с базовым порогом 45%...")

            val sw = bitmap.width
            val sh = bitmap.height
            val sPx = IntArray(sw * sh)
            bitmap.getPixels(sPx, 0, sw, 0, 0, sw, sh)
            val candidates = findTemplateFastCascade(
                sPx, sw, sh,
                template,
                meta,
                templatePath,
                minSimilarityPercent = 45,
                isCancelled = { isCalibrationCancelled }
            )

            logAppEvent(this, "CALIBRATION", "Найдено кандидатов: ${candidates.size}")

            uiExecutor.execute {
                if (isCalibrationCancelled) {
                    restoreControlPanelImmediately()
                    showEditDialog(config)
                    bitmap.recycle()
                    return@execute
                }
                showCandidatesSelectionOverlay(
                    bitmap,
                    template,
                    candidates,
                    isCircle,
                    config,
                    templatePath
                )
            }
        }
    }
