    private fun computeGaussianOffset(radius: Int): Pair<Float, Float> {
        if (radius <= 0) return Pair(0f, 0f)
        val u1 = kotlin.random.Random.nextDouble().coerceAtLeast(1e-7)
        val u2 = kotlin.random.Random.nextDouble()
        val mag = kotlin.math.sqrt(-2.0 * kotlin.math.ln(u1)) * (radius / 2.6)
        val angle = 2.0 * Math.PI * u2
        val gx = (mag * kotlin.math.cos(angle)).toFloat().coerceIn(-radius.toFloat(), radius.toFloat())
        val gy = (mag * kotlin.math.sin(angle)).toFloat().coerceIn(-radius.toFloat(), radius.toFloat())
        return Pair(gx, gy)
    }

