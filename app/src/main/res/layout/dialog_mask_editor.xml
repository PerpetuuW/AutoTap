<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootMaskEditor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:padding="12dp">

    <!-- ЦЕНТРАЛЬНАЯ КАРТОЧКА -->
    <LinearLayout
        android:id="@+id/layoutMaskCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        android:elevation="22dp">

        <!-- Заголовок -->
        <TextView
            android:id="@+id/tvMaskEditorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Редактор маски"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Область изображения -->
        <FrameLayout
            android:id="@+id/layoutMaskImageContainer"
            android:layout_width="match_parent"
            android:layout_height="260dp"
            android:background="@color/bg_dark_blue"
            android:padding="4dp">

            <ImageView
                android:id="@+id/ivMaskPreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitCenter"
                android:adjustViewBounds="true" />

            <!-- Рамка кропа -->
            <FrameLayout
                android:id="@+id/maskCropFrame"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center"
                android:background="@drawable/border_yellow_search_area">

                <View
                    android:id="@+id/handleResizeMask"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/handle_manipulator_bg"
                    android:padding="4dp" />
            </FrameLayout>
        </FrameLayout>

        <!-- Кнопки -->
        <LinearLayout
            android:id="@+id/layoutMaskButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnMaskSave"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="💾 Сохранить"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/accent_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnMaskCopy"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="📄 Копировать"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/bg_dark_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnMaskDelete"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🗑 Удалить"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/red_close"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Закрыть -->
        <Button
            android:id="@+id/btnMaskClose"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Закрыть"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/bg_dark_blue"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
