<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCaptureContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- СРЕДНЯЯ ЗОНА: Рамка прицела -->
    <FrameLayout
        android:id="@+id/captureSquare"
        android:layout_width="140dp"
        android:layout_height="140dp"
        android:layout_gravity="top|start"
        android:background="@drawable/border_capture" />

    <!-- НИЖНЯЯ ПАНЕЛЬ: Ручка переноса (✥) и ручка масштабирования (⤢) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/drag_handle_bg"
        android:padding="4dp"
        android:elevation="10dp">

        <TextView
            android:id="@+id/handleMoveFrame"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✥"
            android:textColor="#FFB703"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/drag_handle_bg"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/handleResize"
            android:layout_width="40dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="⤢"
            android:textColor="#00F5D4"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="@drawable/drag_handle_bg" />
    </LinearLayout>

    <!-- ВЕРХНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ (Вынесена в отдельный слой с высшим Z-индексом) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/drag_handle_bg"
        android:padding="4dp"
        android:elevation="20dp">

        <ImageButton
            android:id="@+id/btnDoCapture"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_camera"
            android:scaleType="centerInside"
            android:background="@color/accent_blue"
            android:contentDescription="Capture"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCaptureSearchArea"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="📐"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="14sp"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnToggleCaptureShape"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:text="🔘"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="14sp"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btnCancelCapture"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:scaleType="centerInside"
            android:background="@color/red_close"
            android:contentDescription="Close" />
    </LinearLayout>
</FrameLayout>
