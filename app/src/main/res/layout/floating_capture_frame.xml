<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutCaptureContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- СРЕДНЯЯ ЗОНА: Кадр прицела -->
    <FrameLayout
        android:id="@+id/captureSquare"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|start"
        android:background="@drawable/border_capture" />

    <!-- НИЖНЯЯ ПАНЕЛЬ: Ручка переноса (✥) и Единственная угловая ручка масштабирования (⤢) -->
    <LinearLayout
        android:id="@+id/layoutBottomBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/drag_handle_bg"
        android:padding="4dp">

        <TextView
            android:id="@+id/handleMoveFrame"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="✥"
            android:textColor="#FFB703"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/drag_handle_bg"
            android:layout_marginEnd="4dp" />

        <TextView
            android:id="@+id/handleResize"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:gravity="center"
            android:text="⤢"
            android:textColor="#00F5D4"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/handle_manipulator_bg" />
    </LinearLayout>

    <!-- ВЕРХНЯЯ ПАНЕЛЬ ДЕЙСТВИЙ (Вынесена в самый конец для высшего Z-индекса и нажатий сверху-слева) -->
    <LinearLayout
        android:id="@+id/layoutTopBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/drag_handle_bg"
        android:padding="4dp"
        android:elevation="20dp">

        <ImageButton
            android:id="@+id/btnDoCapture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_camera"
            android:scaleType="centerInside"
            android:background="@drawable/btn_premium_primary"
            android:padding="6dp"
            android:contentDescription="DoCapture"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnCaptureSearchArea"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:text="📐"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="13sp"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btnToggleCaptureShape"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:minWidth="0dp"
            android:minHeight="36dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:gravity="center"
            android:text="🔘"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="12sp"
            android:padding="0dp"
            android:layout_marginEnd="4dp" />

        <ImageButton
            android:id="@+id/btnCancelCapture"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:scaleType="centerInside"
            android:background="@drawable/btn_premium_record"
            android:padding="5dp"
            android:contentDescription="Close" />
    </LinearLayout>
</FrameLayout>