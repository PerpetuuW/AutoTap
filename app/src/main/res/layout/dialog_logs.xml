<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:background="@color/panel_blue"
        android:padding="20dp"
        android:elevation="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📊 Диагностика и Логи AutoTap"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <ScrollView
            android:overScrollMode="never"
            android:layout_width="match_parent"
            android:layout_height="320dp"
            android:background="@color/bg_dark_blue"
            android:padding="8dp"
            android:layout_marginBottom="16dp">
            
            <TextView
                android:id="@+id/tvLogsContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#F0F6FC"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:text="Загрузка логов..."/>
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnShareLogs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="📋 ПОДЕЛИТЬСЯ"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/accent_blue"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent"/>

            <Button
                android:id="@+id/btnClearLogs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="ОЧИСТИТЬ"
                android:textColor="#FFFFFF"
                android:backgroundTint="@color/red_close"
                android:textSize="11sp"
                android:textStyle="bold"/>

            <View
                android:layout_width="8dp"
                android:layout_height="match_parent"/>

            <Button
                android:id="@+id/btnCloseLogs"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="48dp"
                android:text="ЗАКРЫТЬ"
                android:textColor="#FFFFFF"
                android:backgroundTint="#21262D"
                android:textSize="11sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
