<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_blue"
    android:padding="20dp"
    android:elevation="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Лог ошибок приложения"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <ScrollView
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:layout_marginBottom="20dp">
        <TextView
            android:id="@+id/tvLogsContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:text="Логи пусты."/>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnShareLogs"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="📋 Поделиться"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="Очистить"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/red_close"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnCloseLogs"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="44dp"
            android:text="Закрыть"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2541"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
    </LinearLayout>
</LinearLayout>