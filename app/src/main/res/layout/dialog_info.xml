<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:padding="18dp"
    android:elevation="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💡 Справка и Возможности v28.1.1 PRO"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <Button
            android:id="@+id/tabClick"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Клики"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/accent_blue"/>

        <Button
            android:id="@+id/tabSwipe"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="Свайпы"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/bg_dark_blue"
            android:layout_marginStart="4dp"/>

        <Button
            android:id="@+id/tabAi"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="38dp"
            android:text="ИИ-Сканер"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:backgroundTint="@color/bg_dark_blue"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <ScrollView
        android:overScrollMode="never"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/bg_dark_blue"
        android:padding="10dp"
        android:layout_marginBottom="14dp">

        <TextView
            android:id="@+id/tvTabContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F0F6FC"
            android:textSize="12sp"
            android:lineSpacingExtra="3dp"/>
    </ScrollView>

    <Button
        android:id="@+id/btnCloseInfoDialog"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:text="Закрыть"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        android:textSize="13sp"
        android:backgroundTint="@color/accent_blue"/>
</LinearLayout>
