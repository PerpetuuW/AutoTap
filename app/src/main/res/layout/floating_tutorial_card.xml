<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:padding="14dp"
    android:elevation="18dp">

    <TextView
        android:id="@+id/tvTutTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Подсказка 1/9"
        android:textColor="#00B4D8"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="4dp"/>

    <TextView
        android:id="@+id/tvTutDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:layout_marginBottom="12dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnTutPrev"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="◄ Назад"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2541"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnTutNext"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="Далее ►"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>

        <View
            android:layout_width="4dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnTutSkip"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="36dp"
            android:text="✕"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/red_close"
            android:textSize="10sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"/>
    </LinearLayout>
</LinearLayout>