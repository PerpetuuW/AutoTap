<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/itemScriptRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:background="@drawable/drag_handle_bg"
    android:gravity="center_vertical"
    android:layout_marginBottom="4dp">

    <TextView
        android:id="@+id/tvScriptName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="script_name"
        android:textColor="@color/text_white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnExportScriptFile"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="📤"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/accent_blue"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginEnd="6dp" />

    <Button
        android:id="@+id/btnDeleteScriptFile"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:text="🗑"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/red_close"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />
</LinearLayout>
