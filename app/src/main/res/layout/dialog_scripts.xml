<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="320dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/panel_background"
    android:padding="16dp"
    android:elevation="18dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvScriptTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:text="📂 Управление сценариями"
            android:textColor="@color/text_white"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseScriptsHeader"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:contentDescription="Close"
            android:src="@drawable/ic_close"
            android:tint="#FFFFFF" />
    </RelativeLayout>

    <!-- Блок настроек циклов и сцепки сценариев -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/drag_handle_bg"
        android:padding="8dp"
        android:layout_marginBottom="10dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚙️ Циклы сценария и Эстафета:"
            android:textColor="#FFB703"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="6dp">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="Повторить весь сценарий (раз):"
                android:textColor="@color/text_gray"
                android:textSize="10sp"/>

            <EditText
                android:id="@+id/etScriptLoopCount"
                android:layout_width="60dp"
                android:layout_height="34dp"
                android:background="@color/bg_dark_blue"
                android:textColor="#FFFFFF"
                android:inputType="number"
                android:padding="4dp"
                android:text="1"
                android:gravity="center"
                android:textSize="12sp"
                android:selectAllOnFocus="true"/>
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleScriptInfinite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="Бесконечный цикл всего сценария: НЕТ"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/bg_dark_blue"
            android:textSize="10sp"
            android:layout_marginBottom="6dp"/>

        <Button
            android:id="@+id/btnSelectScriptRelay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="34dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="🔗 Эстафета: [ Выбрать следующий сценарий 📁 ]"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/bg_dark_blue"
            android:textSize="10sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Имя нового сценария:"
        android:textColor="@color/text_gray"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>

    <EditText
        android:id="@+id/etScriptName"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_dark_blue"
        android:textColor="@color/text_white"
        android:padding="8dp"
        android:hint="Мой Сценарий"
        android:textColorHint="@color/text_gray"
        android:textSize="12sp"
        android:selectAllOnFocus="true"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnSaveScriptAction"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="💾 Сохранить текущую схему"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginBottom="10dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Сохраненные сценарии:"
        android:textColor="@color/text_gray"
        android:textSize="11sp"
        android:layout_marginBottom="4dp"/>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:background="@color/bg_dark_blue"
        android:padding="4dp"
        android:overScrollMode="never"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:id="@+id/layoutScriptsList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>
    </ScrollView>

    <Button
        android:id="@+id/btnCloseScripts"
        android:layout_width="match_parent"
        android:layout_height="42dp"
        android:text="Закрыть"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:backgroundTint="@color/red_close"/>
</LinearLayout>
