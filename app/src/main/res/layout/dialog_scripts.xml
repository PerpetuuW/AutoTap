<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootScriptsDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/layoutScriptsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        android:elevation="22dp">

        <TextView
            android:id="@+id/tvScriptsTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сценарии"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Имя сценария -->
        <EditText
            android:id="@+id/etScriptName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Название сценария"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/drag_handle_bg"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Количество повторов -->
        <EditText
            android:id="@+id/etScriptLoopCount"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Количество повторов"
            android:inputType="number"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/drag_handle_bg"
            android:padding="8dp"
            android:layout_marginBottom="8dp" />

        <!-- Кнопки -->
        <LinearLayout
            android:id="@+id/layoutScriptsButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnSaveScriptAction"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="💾 Сохранить"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/accent_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnToggleScriptInfinite"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="♾ Бесконечно"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/bg_dark_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSelectScriptRelay"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="🔗 Эстафета"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/bg_dark_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Список сценариев -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@color/bg_dark_blue"
            android:padding="6dp">

            <LinearLayout
                android:id="@+id/layoutScriptsList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <!-- Закрыть -->
        <Button
            android:id="@+id/btnCloseScripts"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:text="Закрыть"
            android:textColor="@color/text_white"
            android:backgroundTint="@color/bg_dark_blue"
            android:layout_marginTop="12dp" />
    </LinearLayout>
</FrameLayout>
