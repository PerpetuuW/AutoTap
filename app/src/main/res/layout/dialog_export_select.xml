<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_blue"
    android:padding="16dp"
    android:elevation="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📤 Варианты Экспорта"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/btnExpSingleScript"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="1. Один сценарий + его ИИ"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/accent_blue"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnExpChainScripts"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="2. Цепочка (Связанные сценарии)"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2541"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnExpTemplatesOnly"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="3. Только ИИ-шаблоны"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2541"
        android:textSize="11sp"
        android:layout_marginBottom="8dp"/>

    <Button
        android:id="@+id/btnExpFullBackup"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:text="4. Полный Бэкап (Всё вместе)"
        android:textColor="#FFFFFF"
        android:backgroundTint="#1C2541"
        android:textSize="11sp"
        android:layout_marginBottom="14dp"/>

    <Button
        android:id="@+id/btnCloseExpSelect"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Отмена"
        android:textColor="#FFFFFF"
        android:backgroundTint="@color/red_close"
        android:textSize="11sp"/>
</LinearLayout>