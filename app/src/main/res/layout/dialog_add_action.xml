<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="260dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_blue"
    android:padding="16dp"
    android:elevation="16dp">
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Добавить действие"
        android:textColor="@color/text_white"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>
    <Button
        android:id="@+id/btnAddClick"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="+ Обычный клик"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/accent_blue"
        android:layout_marginBottom="8dp"/>
    <Button
        android:id="@+id/btnAddSwipe"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="+ Свайп (Начало/Конец)"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/bg_dark_blue"
        android:layout_marginBottom="8dp"/>
    <Button
        android:id="@+id/btnAddTrigger"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:text="+ Поиск ИИ-картинки"
        android:textColor="@color/text_white"
        android:backgroundTint="@color/bg_dark_blue"
        android:layout_marginBottom="16dp"/>
    <Button
        android:id="@+id/btnCancelAdd"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="Отмена"
        android:backgroundTint="@color/red_close"
        android:insetTop="0dp"
        android:insetBottom="0dp"/>
</LinearLayout>