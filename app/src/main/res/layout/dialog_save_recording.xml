<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="280dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/panel_blue"
    android:padding="16dp"
    android:elevation="18dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="💾 Сохранить запись"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Введите имя для нового сценария:"
        android:textColor="@color/text_gray"
        android:textSize="12sp"
        android:layout_marginBottom="4dp"/>

    <EditText
            android:selectAllOnFocus="true"
        android:id="@+id/etRecordScriptName"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:background="@color/bg_dark_blue"
        android:textColor="#FFFFFF"
        android:padding="8dp"
        android:hint="Имя сценария"
        android:textColorHint="@color/text_gray"
        android:layout_marginBottom="14dp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnSaveRecordScript"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Сохранить"
            android:textColor="#FFFFFF"
            android:backgroundTint="@color/accent_blue"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="6dp"
            android:layout_height="match_parent"/>

        <Button
            android:id="@+id/btnSkipRecordScript"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="42dp"
            android:text="Пропустить"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2541"
            android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>