<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootSaveRecordingDialog"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#CC000000"
    android:padding="12dp">

    <LinearLayout
        android:id="@+id/layoutSaveCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/panel_background"
        android:padding="12dp"
        android:elevation="22dp">

        <TextView
            android:id="@+id/tvSaveTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Сохранение записи"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Имя сценария -->
        <EditText
            android:id="@+id/etSaveScriptName"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Название сценария"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/drag_handle_bg"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Количество повторов -->
        <EditText
            android:id="@+id/etSaveLoopCount"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:hint="Количество повторов"
            android:inputType="number"
            android:textColor="@color/text_white"
            android:textColorHint="@color/text_gray"
            android:background="@drawable/drag_handle_bg"
            android:padding="8dp"
            android:layout_marginBottom="10dp" />

        <!-- Бесконечный цикл -->
        <CheckBox
            android:id="@+id/cbSaveInfinite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Бесконечный цикл"
            android:textColor="@color/text_white"
            android:layout_marginBottom="12dp" />

        <!-- Кнопки -->
        <LinearLayout
            android:id="@+id/layoutSaveButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <Button
                android:id="@+id/btnSaveRecording"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="💾 Сохранить"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/accent_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:layout_marginEnd="8dp" />

            <Button
                android:id="@+id/btnSaveClose"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Закрыть"
                android:textColor="@color/text_white"
                android:backgroundTint="@color/bg_dark_blue"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
