6. Delta‑E: отключение HDR / fallback
Правильно:

Если экран в HDR — не использовать LAB‑сравнение, а падать на более грубый порог.

kotlin
fun isHdrEnabled(context: Context): Boolean {
    val wm = context.getSystemService(Context.WINDOW_SERVICE) as WindowManager
    val mode = wm.defaultDisplay?.mode
    return mode?.isHdr == true
}

fun colorsEqualPerceptive(c1: Int, c2: Int, context: Context): Boolean {
    if (isHdrEnabled(context)) {
        // fallback: простой порог по яркости/каналам
        val dr = Math.abs(Color.red(c1) - Color.red(c2))
        val dg = Math.abs(Color.green(c1) - Color.green(c2))
        val db = Math.abs(Color.blue(c1) - Color.blue(c2))
        return dr + dg + db < 40
    }
    // нормальный LAB Delta-E
    val de = deltaE(c1, c2)
    return de < 3.0
}
