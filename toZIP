#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Собирает ключевые файлы Android-проекта AutoTap в один zip для анализа
(только исходники и конфиги — без build-кэша, .gradle, .idea, apk и т.п.)

Запуск: положить скрипт в корень проекта (рядом с settings.gradle.kts)
и выполнить:
    python make_analysis_zip.py
"""

import zipfile
from pathlib import Path

# Корень проекта = папка, где лежит этот скрипт
PROJECT_ROOT = Path(__file__).resolve().parent
OUTPUT_ZIP = PROJECT_ROOT / "AutoTap_analysis.zip"

# Пакет приложения — поменяйте, если путь исходников другой
PACKAGE_PATH = "app/src/main/java/com/example/autotap"

# Список путей/масок относительно корня проекта
PATTERNS = [
    "build.gradle.kts",
    "settings.gradle.kts",
    "gradle.properties",
    "app/build.gradle.kts",
    "app/src/main/AndroidManifest.xml",
    f"{PACKAGE_PATH}/*.kt",
    "app/src/main/res/layout/*.xml",
    "app/src/main/res/values/*.xml",
    "app/src/main/res/values-night/*.xml",
    "app/src/main/res/xml/*.xml",
    "app/src/main/res/drawable/*.xml",
]


def collect_files():
    files = []
    for pattern in PATTERNS:
        if "*" in pattern:
            matches = sorted(PROJECT_ROOT.glob(pattern))
        else:
            p = PROJECT_ROOT / pattern
            matches = [p] if p.exists() else []
        if not matches:
            print(f"  (пропущено, не найдено) {pattern}")
        files.extend(matches)
    return files


def main():
    if OUTPUT_ZIP.exists():
        OUTPUT_ZIP.unlink()

    files = collect_files()

    with zipfile.ZipFile(OUTPUT_ZIP, "w", zipfile.ZIP_DEFLATED) as zf:
        for f in files:
            arcname = f.relative_to(PROJECT_ROOT)
            zf.write(f, arcname)
            print(f"  + {arcname}")

    size_kb = OUTPUT_ZIP.stat().st_size / 1024
    print(f"\nГотово: {OUTPUT_ZIP.name} ({len(files)} файлов, {size_kb:.1f} КБ)")


if __name__ == "__main__":
    main()